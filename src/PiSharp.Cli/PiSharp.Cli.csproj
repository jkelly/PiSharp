<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <EnablePromptTemplateYaml Condition="'$(EnablePromptTemplateYaml)' == ''">true</EnablePromptTemplateYaml>
    <!-- The disabled CLI graph has its own coordinator-generated lock; normal locks stay intact. -->
    <NuGetLockFilePath Condition="'$(EnablePromptTemplateYaml)' == 'false'">$(MSBuildProjectDirectory)/packages.prompt-yaml-disabled.lock.json</NuGetLockFilePath>
    <DefineConstants Condition="'$(EnablePromptTemplateYaml)' == 'true'">$(DefineConstants);PISHARP_PROMPT_YAML</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PiSharp.CodingAgent.Tests" />
    <InternalsVisibleTo Include="PiSharp.NodeCommandInputPackage.Tests" />
    <InternalsVisibleTo Include="PiSharp.CliSync.Tests" />
    <InternalsVisibleTo Include="PiSharp.McpSync.Tests" />
    <InternalsVisibleTo Include="PiSharp.ToolSearch.Tests" />
    <InternalsVisibleTo Include="PiSharp.Models.Tests" />
    <InternalsVisibleTo Include="PiSharp.Codemode.Tests" />
    <InternalsVisibleTo Include="PiSharp.CliParity.Tests" />
    <InternalsVisibleTo Include="PiSharp.ExtensionParity.Tests" />
    <InternalsVisibleTo Include="PiSharp.InteractiveParity.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../PiSharp.CodingAgent/PiSharp.CodingAgent.csproj" />
    <ProjectReference Include="../PiSharp.PromptTemplates.Yaml/PiSharp.PromptTemplates.Yaml.csproj" Condition="'$(EnablePromptTemplateYaml)' == 'true'" />
    <ProjectReference Include="../PiSharp.Tools/PiSharp.Tools.csproj" />
    <ProjectReference Include="../PiSharp.Tools.Skia/PiSharp.Tools.Skia.csproj" />
    <ProjectReference Include="../PiSharp.Rpc/PiSharp.Rpc.csproj" />
    <ProjectReference Include="../PiSharp.Tui/PiSharp.Tui.csproj" />
    <ProjectReference Include="../PiSharp.Extensions.Runtime/PiSharp.Extensions.Runtime.csproj" />
    <ProjectReference Include="../PiSharp.Extensions.Agent/PiSharp.Extensions.Agent.csproj" />
    <ProjectReference Include="../PiSharp.Codemode/PiSharp.Codemode.csproj" />
    <ProjectReference Include="../PiSharp.Compatibility.Node/PiSharp.Compatibility.Node.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Node extension host (IMPL-E): TypeScript/JavaScript extensions run in the user's Node with these scripts. -->
    <None Include="../../tools/NodeBridge/pi-host/**/*.mjs;../../tools/NodeBridge/pi-host/**/*.json" Exclude="../../tools/NodeBridge/pi-host/**/selftest.mjs;../../tools/NodeBridge/pi-host/**/port-upstream.mjs;../../tools/NodeBridge/pi-host/**/upstream-exports.json"
          Link="node-bridge/pi-host/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="false" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Models/*.json" LogicalName="PiSharp.Cli.Models.%(Filename)%(Extension)" />
    <!-- The highlight.js 10.7.3 grammars (tools/HljsGrammars/extract-grammars.mjs), read by HljsGrammarData. -->
    <EmbeddedResource Include="Interactive/Mode/Theme/Highlight/hljs-grammars.json.gz" LogicalName="PiSharp.Cli.Hljs.grammars.json.gz" />
  </ItemGroup>
  <ItemGroup>
    <!-- The read tool's SkiaSharp image codec (owner decision 0004) and its native Skia components. -->
    <None Include="../../third-party/SkiaSharp.LICENSE.txt" Link="licenses/SkiaSharp.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="false" />
    <None Include="../../third-party/SkiaSharp.THIRD-PARTY-NOTICES.txt" Link="licenses/SkiaSharp.THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="false" />
    <!-- The interactive syntax highlighter ports highlight.js 10.7.3 (BSD-3-Clause). -->
    <None Include="../../third-party/highlight.js.LICENSE.txt" Link="licenses/highlight.js.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="false" />
    <!-- The interactive Mermaid renderer ports grok-mermaid 0.2.3 (Apache-2.0). -->
    <None Include="../../third-party/grok-mermaid.LICENSE.txt" Link="licenses/grok-mermaid.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(EnablePromptTemplateYaml)' == 'true'">
    <None Include="../../third-party/YamlDotNet.LICENSE.txt" Link="licenses/YamlDotNet.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="false" />
    <!-- The codemode tool's description names this reference (CodemodeToolDefinition.DocsPath). -->
    <None Include="docs/codemode.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="false" />
    <!-- What's New and /changelog read CHANGELOG.md next to the executable (built from website/src/content/changelog). -->
    <None Include="../../CHANGELOG.md" Link="CHANGELOG.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="false" />
    <None Include="../../third-party/Jint.LICENSE.txt;../../third-party/Jint.CREDITS.txt;../../third-party/Acornima.LICENSE.txt;../../third-party/Acornima.NOTICE.txt" Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="false" />
  </ItemGroup>
</Project>
