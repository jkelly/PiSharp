<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Decision 0008, Phases 6 and 7 (PiSharp-only, branch feature/durable-network): PiSharp Durable Web, an ASP.NET Core MVC hub and UI for
       durable devices (`pisharp durable serve`, or durable-pi's dpi-backend). It runs no agents: it keeps a registry of devices with their
       tokens encrypted by Data Protection, watches them, proxies the browser's requests with the token added, and reduces each device's
       streams into Razor fragments that one Server-Sent Events stream per tab carries. Designs after durable-pi's playground (MIT); the
       look is the PiSharp Web Agent design system. Not packed. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);PISHARP_DURABLE001</NoWarn>
    <IsPackable>false</IsPackable>
    <UserSecretsId>pisharp-durable-web</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PiSharp.Durable.Web.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../PiSharp.Durable.Client/PiSharp.Durable.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Markdig" Version="[0.41.3]" />
    <PackageReference Include="HtmlSanitizer" Version="[9.0.886]" />
    <PackageReference Include="YamlDotNet" Version="[16.3.0]" />
    <!-- The registry's SQLite, with PiSharp.Durable.Sqlite's exact pins (decision 0005). -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="[10.0.12]" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="[2.1.12]" />
    <PackageReference Include="SQLitePCLRaw.core" Version="[2.1.12]" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="[2.1.12]" />
    <PackageReference Include="SQLitePCLRaw.provider.e_sqlite3" Version="[2.1.12]" />
  </ItemGroup>
</Project>
