<!doctype html>
<html lang="en" data-bs-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@(ViewData["Title"] ?? "Network") · PiSharp Durable</title>
  @* The favicon, theme, Bootstrap, icons and shared shell styles (PiSharp.Web.Common); the hub's own styles follow. *@
  <partial name="_WebCommonHead" model='"pisharp-durable-theme"' />
  <link href="/css/durable.css" rel="stylesheet" asp-append-version="true">
  <link href="/css/web.css" rel="stylesheet" asp-append-version="true">
</head>
<body class="app-body" data-page="@(ViewData["Page"] ?? "network")">
@RenderBody()

<div class="dn-toasts">
  <div class="toast align-items-center" id="toast" role="status" aria-live="polite" aria-atomic="true">
    <div class="d-flex"><div class="toast-body d-flex align-items-center gap-2"><i class="bi bi-check2" data-toast-icon></i><span class="toast-text">Saved.</span></div><button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button></div>
  </div>
</div>

<script src="@WebCommonAssets.BootstrapJs"></script>
@RenderSection("Scripts", required: false)
</body>
</html>
