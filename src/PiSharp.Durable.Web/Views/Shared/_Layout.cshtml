<!doctype html>
<html lang="en" data-bs-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@(ViewData["Title"] ?? "Network") · PiSharp Durable</title>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <script>
    (function () {
      try { var theme = localStorage.getItem('pisharp-durable-theme'); if (theme === 'light') document.documentElement.setAttribute('data-bs-theme', 'light'); } catch (e) { }
    })();
  </script>
  <link href="/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/lib/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/pisharp-theme.css" rel="stylesheet" asp-append-version="true">
  <link href="/css/app.css" rel="stylesheet" asp-append-version="true">
  <link href="/css/durable.css" rel="stylesheet" asp-append-version="true">
  <link href="/css/web.css" rel="stylesheet" asp-append-version="true">
</head>
<body class="app-body" data-page="@(ViewData["Page"] ?? "network")">
@RenderBody()

<div class="dn-toasts">
  <div class="toast align-items-center" id="toast" role="status" aria-live="polite" aria-atomic="true">
    <div class="d-flex"><div class="toast-body d-flex align-items-center gap-2"><i class="bi bi-check2" data-toast-icon></i><span class="toast-text">Saved.</span></div><button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button></div>
  </div>
</div>

<script src="/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
@RenderSection("Scripts", required: false)
</body>
</html>
