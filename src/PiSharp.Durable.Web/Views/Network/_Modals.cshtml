@model NetworkPage

<div class="modal fade" id="modal-new-session" tabindex="-1" aria-labelledby="ns-title" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <form class="modal-content" id="ns-form" novalidate>
      <div class="modal-header">
        <div><h2 class="modal-title" id="ns-title">New session</h2><div class="modal-subtitle">A persistent workspace: one database and one working directory on a device.</div></div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div data-ns-form>
          <div class="row g-3">
            <div class="col-sm-6">
              <label class="form-label" for="ns-device">Device</label>
              <select class="form-select" id="ns-device"></select>
              <div class="form-text">Online devices only.</div>
            </div>
            <div class="col-sm-6">
              <label class="form-label" for="ns-name">Session name</label>
              <input class="form-control" id="ns-name" maxlength="100" placeholder="My durable agent">
              <div class="form-text">Blank uses "New session".</div>
            </div>
            <div class="col-12">
              <label class="form-label" for="ns-cwd">Working directory on <span data-ns-device-name></span></label>
              <div class="input-group"><input class="form-control font-monospace" id="ns-cwd" placeholder="Path to a folder" autocomplete="off"><button class="btn btn-outline-secondary" type="button" data-ns-go>Go</button></div>
              <div class="dir-list" role="listbox" aria-label="Directories" data-dir-list></div>
              <div class="form-text">Start directories: <span class="ps-mono" data-ns-start-dirs></span>. They choose where sessions begin. They are not a sandbox: the agent can reach anything the device's user can.</div>
            </div>
            <div class="col-12">
              <div class="row g-2">
                <div class="col-sm-6">
                  <label class="form-label" for="ns-provider">Provider</label>
                  <select class="form-select" id="ns-provider"></select>
                </div>
                <div class="col-sm-6">
                  <label class="form-label" for="ns-model">Model</label>
                  <select class="form-select" id="ns-model"></select>
                  <div class="form-text" data-ns-model-line></div>
                </div>
              </div>
              <div class="form-text">Models available on the device. Provider keys stay on the device.</div>
            </div>
            <div class="col-sm-6">
              <label class="form-label" for="ns-thinking">Thinking</label>
              <select class="form-select" id="ns-thinking">
                @foreach (var level in DurableWire.ThinkingLevels)
                {
                  <option selected="@(level == "low")">@level</option>
                }
              </select>
            </div>
          </div>
          <div class="alert alert-danger mt-3 mb-0" data-ns-error hidden></div>
        </div>
        <div data-ns-nodevice hidden>
          <div class="alert alert-danger mb-0"><i class="bi bi-wifi-off me-1"></i>No device is online. Start one with <code>pisharp durable serve</code>, then press Check on its row.</div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary" data-ns-create>Create session</button>
      </div>
    </form>
  </div>
</div>

<div class="modal fade" id="modal-model-picker" tabindex="-1" aria-labelledby="mp-title" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <form class="modal-content" id="mp-form">
      <div class="modal-header">
        <div><h2 class="modal-title" id="mp-title">Choose a model</h2><div class="modal-subtitle">For <span data-mp-agent></span>. Used from the next request.</div></div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="row g-2">
          <div class="col-sm-6">
            <label class="form-label" for="mp-provider">Provider</label>
            <select class="form-select" id="mp-provider"></select>
          </div>
          <div class="col-sm-6">
            <label class="form-label" for="mp-model">Model</label>
            <select class="form-select" id="mp-model"></select>
            <div class="form-text" data-mp-model-line></div>
          </div>
        </div>
      </div>
      <div class="modal-footer justify-content-between">
        <span class="fs-7 text-ps-faint">Models available on the device. Provider keys stay on the device.</span>
        <div class="d-flex gap-2">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Use model</button>
        </div>
      </div>
    </form>
  </div>
</div>

<div class="modal fade" id="modal-prompt" tabindex="-1" aria-labelledby="pr-title" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <form class="modal-content" id="pr-form">
      <div class="modal-header">
        <h2 class="modal-title" id="pr-title" data-pr-title>Rename</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="fs-7 text-secondary" data-pr-text hidden></p>
        <div data-pr-field>
          <label class="form-label" for="pr-input" data-pr-label>Name</label>
          <input class="form-control" id="pr-input" maxlength="100" autocomplete="off">
          <div class="form-text" data-pr-hint></div>
        </div>
        <div class="alert alert-danger mt-3 mb-0" data-pr-error hidden></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary" data-pr-submit>Save name</button>
      </div>
    </form>
  </div>
</div>

<div class="modal fade" id="modal-path" tabindex="-1" aria-labelledby="path-title" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header"><h2 class="modal-title" id="path-title">Working directory</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
      <div class="modal-body">
        <div class="ps-term"><div class="ps-term-bar"><span data-path-label></span><button class="btn btn-icon ms-auto" type="button" data-copy="#full-path" title="Copy" aria-label="Copy path"><i class="bi bi-copy"></i></button></div><pre id="full-path" class="wrap"></pre></div>
      </div>
      <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button></div>
    </div>
  </div>
</div>

<div class="modal fade" id="modal-compaction" tabindex="-1" aria-labelledby="cmp-title" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header"><h2 class="modal-title" id="cmp-title">Context compaction</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
      <div class="modal-body">
        <p class="fs-7">Compaction summarises older entries so the model sees less. At the first marker a summary is written in the background while the agent keeps working. At the second, the next request waits for it.</p>
        <p class="fs-7 text-secondary">Older entries stay stored, and <code>search_history</code> still finds them.</p>
        <div class="form-check form-switch mb-3"><input class="form-check-input" type="checkbox" role="switch" id="cmp-auto"><label class="form-check-label" for="cmp-auto">Automatic compaction</label></div>
        <div class="row g-2 mb-2">
          <div class="col-6"><label class="form-label" for="cmp-keep">Keep recent tokens</label><input class="form-control" id="cmp-keep" type="number" min="500" max="200000" step="1000"><div class="form-text">Roughly how much recent context stays verbatim.</div></div>
          <div class="col-6"><div class="kv"><span class="k">Background at</span><span class="v" data-cmp-auto></span></div><div class="kv"><span class="k">Waits at</span><span class="v" data-cmp-wait></span></div><div class="kv"><span class="k">Window</span><span class="v" data-cmp-window></span></div></div>
        </div>
        <div class="form-text">Applies to every agent in this session. <code>/compact</code> works either way.</div>
      </div>
      <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button></div>
    </div>
  </div>
</div>

<partial name="~/Views/Shared/_HelpModals.cshtml" />
