<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><IsPackable>false</IsPackable><NoWarn>$(NoWarn);PISHARP_DURABLE001;PISHARP_TELEMETRY001;PISHARP_ENV001</NoWarn></PropertyGroup>
  <PropertyGroup Condition="'$(PiSharpEnvNativePublish)' == 'true'">
    <!-- This application is published with AOT. Referenced provider libraries
         retain their own supported API boundaries; final ILC analyzes every
         method actually reachable from this executable with fatal diagnostics. -->
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PiSharp.Env.Protocol/PiSharp.Env.Protocol.csproj" />
    <ProjectReference Include="../PiSharp.Durable/PiSharp.Durable.csproj" />
    <ProjectReference Include="../PiSharp.Durable.Tools/PiSharp.Durable.Tools.csproj" />
  </ItemGroup>
  <Import Project="Native/PiSharp.Env.Native.targets" />
</Project>
