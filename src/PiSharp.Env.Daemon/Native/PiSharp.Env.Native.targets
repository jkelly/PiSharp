<Project>
  <PropertyGroup>
    <PiSharpNativeName Condition="$([MSBuild]::IsOSPlatform('Linux'))">libpisharp_env_native.so</PiSharpNativeName>
    <PiSharpNativeName Condition="$([MSBuild]::IsOSPlatform('OSX'))">libpisharp_env_native.dylib</PiSharpNativeName>
    <PiSharpNativePath Condition="'$(PiSharpNativeName)' != ''">$(MSBuildProjectDirectory)/obj/$(Configuration)/$(TargetFramework)/native/$(PiSharpNativeName)</PiSharpNativePath>
    <PiSharpNativeCompiler Condition="'$(PiSharpNativeCompiler)' == ''">cc</PiSharpNativeCompiler>
    <PiSharpNativeLinkFlags Condition="$([MSBuild]::IsOSPlatform('Linux'))">-shared -lutil</PiSharpNativeLinkFlags>
    <PiSharpNativeLinkFlags Condition="$([MSBuild]::IsOSPlatform('OSX'))">-dynamiclib</PiSharpNativeLinkFlags>
    <PiSharpNativeArchive Condition="'$(PiSharpNativeName)' != ''">$(MSBuildProjectDirectory)/obj/$(Configuration)/$(TargetFramework)/native/libpisharp_env_native.a</PiSharpNativeArchive>
  </PropertyGroup>
  <ItemGroup Condition="'$(PiSharpNativeName)' != ''">
    <None Include="$(PiSharpNativePath)" Link="$(PiSharpNativeName)" CopyToOutputDirectory="PreserveNewest">
      <CopyToPublishDirectory Condition="'$(PublishAot)' != 'true'">PreserveNewest</CopyToPublishDirectory>
      <CopyToPublishDirectory Condition="'$(PublishAot)' == 'true'">Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>
  <Target Name="BuildPiSharpEnvNative" BeforeTargets="PrepareForBuild" Condition="'$(PiSharpNativeName)' != ''" Inputs="$(MSBuildThisFileDirectory)pisharp_env_native.c" Outputs="$(PiSharpNativePath)">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(PiSharpNativePath)'))" />
    <Exec Command="$(PiSharpNativeCompiler) -std=c11 -O2 -fPIC -fvisibility=hidden -Wall -Wextra -Werror &quot;$(MSBuildThisFileDirectory)pisharp_env_native.c&quot; -o &quot;$(PiSharpNativePath)&quot; $(PiSharpNativeLinkFlags)" />
  </Target>
  <!-- A published remote daemon is a single NativeAOT executable. Resolve its
       P/Invokes directly from the archive; no sidecar is needed by SSH bootstrap. -->
  <ItemGroup Condition="'$(PublishAot)' == 'true' And '$(PiSharpNativeName)' != ''">
    <DirectPInvoke Include="pisharp_env_native" />
    <NativeLibrary Include="$(PiSharpNativeArchive)" />
    <LinkerArg Include="-lutil" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
  </ItemGroup>
  <Target Name="BuildPiSharpEnvNativeArchive" BeforeTargets="PrepareForILLink;IlcCompile" DependsOnTargets="BuildPiSharpEnvNative" Condition="'$(PublishAot)' == 'true' And '$(PiSharpNativeName)' != ''" Inputs="$(MSBuildThisFileDirectory)pisharp_env_native.c" Outputs="$(PiSharpNativeArchive)">
    <Exec Command="$(PiSharpNativeCompiler) -std=c11 -O2 -fPIC -fvisibility=hidden -Wall -Wextra -Werror -c &quot;$(MSBuildThisFileDirectory)pisharp_env_native.c&quot; -o &quot;$(PiSharpNativeArchive).o&quot;" />
    <Exec Command="ar rcs &quot;$(PiSharpNativeArchive)&quot; &quot;$(PiSharpNativeArchive).o&quot;" />
  </Target>
</Project>
