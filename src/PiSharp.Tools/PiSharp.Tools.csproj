<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The pi.exec capture limit (source execCommand maxBuffer) is [Experimental]; the runners here apply it. -->
    <NoWarn>$(NoWarn);PISHARP_EXEC001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- The SkiaSharp image codec shares the RGBA raster, Lanczos3 resampling and EXIF orientation. -->
    <InternalsVisibleTo Include="PiSharp.Tools.Skia" />
    <!-- Branch feature/pi-durable (decision 0005): the durable execution environment reuses the Windows job-object process lifetime and
         the spawn preflight. Branch-only seam; flag for removal if the durable port does not merge. -->
    <InternalsVisibleTo Include="PiSharp.Durable.Tools" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../PiSharp.Agent/PiSharp.Agent.csproj" />
    <ProjectReference Include="../PiSharp.Contracts/PiSharp.Contracts.csproj" />
  </ItemGroup>
</Project>
