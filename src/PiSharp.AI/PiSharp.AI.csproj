<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Pi 1.5.0 telemetry (pi-telemetry, ai telemetry.ts) is [Experimental("PISHARP_TELEMETRY001")]; chat runs trace a request's span. -->
    <NoWarn>$(NoWarn);PISHARP_TELEMETRY001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Catalogs/reviewed-2026-11-08.json" />
    <EmbeddedResource Include="Catalogs/Releases/1.5.2/*.json" Exclude="Catalogs/Releases/1.5.2/.manifest.json"
                      LogicalName="PiSharp.AI.Catalogs.Releases.1.5.2.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Catalogs/Releases/1.5.2/.manifest.json" LogicalName="PiSharp.AI.Catalogs.Releases.1.5.2..manifest.json" />
    <EmbeddedResource Include="Catalogs/Releases/1.6.0/*.json" Exclude="Catalogs/Releases/1.6.0/.manifest.json"
                      LogicalName="PiSharp.AI.Catalogs.Releases.1.6.0.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Catalogs/Releases/1.6.0/.manifest.json" LogicalName="PiSharp.AI.Catalogs.Releases.1.6.0..manifest.json" />
    <EmbeddedResource Include="Catalogs/reviewed-2026-11-10.json" />
    <ProjectReference Include="../PiSharp.Contracts/PiSharp.Contracts.csproj" />
    <!-- pi-ai depends on pi-telemetry: the request option's span type and the pi.ai.request / pi.ai.poll schema. -->
    <ProjectReference Include="../PiSharp.Telemetry/PiSharp.Telemetry.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- WhatwgUrl: bug-report redaction re-serializes URLs with the same WHATWG subset as the Azure endpoint. -->
    <InternalsVisibleTo Include="PiSharp.CodingAgent" />
  </ItemGroup>
</Project>
