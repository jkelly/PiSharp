@* Decision 0011 (run W3, SU): the wizard's own layout. The mockups' setup.html is a full page without the sidebar or the app's top bar,
   so it does not use _Layout; it has the same head (Web.Common's _WebCommonHead: the favicon, theme-boot.js before the first paint, Bootstrap
   and the PiSharp tokens; then site.css), the toast area and the same scripts (Bootstrap, then site.js, which starts the shell: the theme
   toggle and the toasts). Dark is the default. No inline script (the Content-Security-Policy has script-src 'self'). A page sets
   ViewData["Title"] and may define the sections Styles, Modals and Scripts. *@
@{
    var title = ViewData["Title"] as string ?? "Setup";
}
<!doctype html>
<html lang="en" data-bs-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@title · PiSharp Web Agent</title>
  <partial name="_WebCommonHead" model='"pisharp-theme"' />
  <link href="~/css/site.css" rel="stylesheet" asp-append-version="true">
  @await RenderSectionAsync("Styles", required: false)
</head>
<body class="setup-body" data-page="setup">
@RenderBody()
@await RenderSectionAsync("Modals", required: false)
<partial name="_Toasts" model="null" />

<script src="@WebCommonAssets.BootstrapJs"></script>
<script type="module" src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
