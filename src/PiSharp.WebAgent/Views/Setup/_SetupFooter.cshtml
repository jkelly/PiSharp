@* Decision 0011 (run W3, SU): the wizard's footer: per step (data-setup-only names the steps an item shows on) Skip setup, Back, the
   connected count, Get started, Continue (disabled, with the reason, while nothing is connected) and Save and continue. Skip setup POSTs
   /api/setup/skip and opens a new chat; Save and continue POSTs /api/setup/finish and shows Done (setup.js). Model: SetupPage. *@
@model SetupPage
@{
    var current = SetupPage.StepName(Model.Step);
    bool Hidden(string steps) => !steps.Split(' ').Contains(current, StringComparer.Ordinal);
}
<div class="px-3 px-sm-4 py-3 border-top d-flex align-items-center gap-2 flex-wrap" data-setup-footer>
  <button class="btn btn-sm btn-ghost" type="button" data-setup-skip data-setup-only="welcome" hidden="@Hidden("welcome")">Skip setup</button>
  <button class="btn btn-sm btn-ghost" type="button" data-setup-go="welcome" data-setup-only="connect" hidden="@Hidden("connect")"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back</button>
  <button class="btn btn-sm btn-ghost" type="button" data-setup-go="connect" data-setup-only="model" hidden="@Hidden("model")"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back</button>
  <button class="btn btn-sm btn-ghost" type="button" data-setup-go="model" data-setup-only="done" hidden="@Hidden("done")"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back</button>
  <span class="fs-8 text-ps-faint ms-auto ps-mono" data-setup-only="connect model" data-setup-count hidden="@Hidden("connect model")">@SetupText.ConnectedCount(Model.Connected.Count)</span>
  <button class="btn btn-primary ms-auto" type="button" data-setup-go="connect" data-setup-only="welcome" hidden="@Hidden("welcome")">Get started<i class="bi bi-arrow-right ms-1" aria-hidden="true"></i></button>
  <span data-setup-only="connect" hidden="@Hidden("connect")">
    @if (Model.NothingConnected)
    {
      <span class="d-inline-block" tabindex="0" title="Connect at least one provider first" data-setup-continue-blocked><button class="btn btn-primary" type="button" disabled style="pointer-events:none" aria-describedby="setupContinueWhy">Continue<i class="bi bi-arrow-right ms-1" aria-hidden="true"></i></button><span class="visually-hidden" id="setupContinueWhy">Connect at least one provider first</span></span>
    }
    else
    {
      <button class="btn btn-primary" type="button" data-setup-go="model">Continue<i class="bi bi-arrow-right ms-1" aria-hidden="true"></i></button>
    }
  </span>
  <button class="btn btn-primary" type="button" data-setup-finish data-setup-only="model" hidden="@Hidden("model")">Save and continue<i class="bi bi-arrow-right ms-1" aria-hidden="true"></i></button>
</div>
