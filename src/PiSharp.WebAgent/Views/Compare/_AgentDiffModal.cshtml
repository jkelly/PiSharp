<div class="modal fade" id="modal-agent-diff" tabindex="-1" aria-labelledby="modal-agent-diff-title" aria-hidden="true" data-ac-modal>
  <div class="modal-dialog modal-xl modal-dialog-scrollable modal-fullscreen-md-down">
