@* Decision 0011 (run W2, WU7, WU8): one tool call card, after the mockups' tool cards: the tool's icon, name and arguments, a status chip
   (a spinner while it runs; done, error or denied; "Not re-run after restart" when a restart cut it off, or "Not started after restart"
   when it never started) and the stored duration; inside, the input, live output (committed about every 150 ms), the result and nested
   calls. The restart chip comes from the stored result's diagnostic (interrupted or abandoned), not from its text. A call that waits for
   the user's approval shows the inline approval card (_ChatApproval) under it; questions and plan reviews wait in the "Waiting for you"
   panel. *@
@model ChatToolView
@{
    var call = Model.Call;
    var approval = Model.Nested ? null : Model.Context.Approval(call.CallId);
    var stored = Model.Context.Result(call.CallId);
    var args = call.Args as JsonObject;
    var command = PiSharp.WebAgent.Chat.ToolAllowList.CommandOf(call.Name, args);
    var waitsForYou = approval is not null || (call.Status == ToolStatus.Running && call.Name is "ask_user_question" or "exit_plan_mode");
    var restarted = stored is { Restarted: true };
    var stopped = stored?.Code == "aborted";
    var denied = call.Status == ToolStatus.Error && (call.Result ?? "").StartsWith("The user denied", StringComparison.Ordinal);
    var running = call.Status is ToolStatus.Running or ToolStatus.Pending && !waitsForYou;
    var cardClass = call.Status switch
    {
        ToolStatus.Error when restarted || stopped => "",
        ToolStatus.Error => "is-error",
        ToolStatus.Running or ToolStatus.Pending => "is-running",
        _ => "",
    };
    var nestedCount = call.Nested.Count;
    var open = (running && call.Output is not null) || (call.Status == ToolStatus.Error && !denied && !stopped);
    // The harness's note of a restart or a Stop ends the stored result; the chip and the note below say it instead.
    var result = call.Result is { } text && (restarted || stopped) ? System.Text.RegularExpressions.Regex.Replace(text, @"\s*<harness>[\s\S]*?</harness>\s*$", "") : call.Result;
}
<details class="tool-card @cardClass" data-detail="call-@call.CallId" data-call="@call.CallId" data-restart="@(restarted ? stored!.Code : null)" open="@open">
  <summary><span class="tool-icon"><i class="bi @(call.Status == ToolStatus.Error && !restarted && !stopped ? "bi-exclamation-circle" : ChatDisplay.ToolIcon(call.Name))"></i></span><span class="tool-name">@call.Name</span><span class="tool-args-summary">@(command is not null ? ChatDisplay.Cut(command.ReplaceLineEndings(" "), 140) : ChatDisplay.ArgsSummary(call.Args))</span>@if (restarted)
    {<span class="ps-chip" title="A restart cut this call off. PiSharp never runs a tool again by itself.">@(stored!.Code == "abandoned" ? "Not started after restart" : "Not re-run after restart")</span>}
    else if (waitsForYou)
    {<span class="ps-chip"><span class="status-dot waiting" aria-hidden="true"></span>@(approval is not null ? "waiting for approval" : "waiting for you")</span>}
    else if (running)
    {<span class="ps-chip"><span class="spinner-border spinner-border-sm chip-spinner" aria-hidden="true"></span>@(call.Status == ToolStatus.Pending ? "pending" : "running")</span>}
    else if (denied)
    {<span class="ps-chip" data-tone="danger">denied</span>}
    else if (stopped)
    {<span class="ps-chip">stopped</span>}
    else if (call.Status == ToolStatus.Error)
    {<span class="ps-chip" data-tone="danger">error</span>}
    else
    {<span class="ps-chip" data-tone="ok">done</span>}@if (stored?.DurationMs is { } duration)
    {<span class="tool-duration">@ChatDisplay.Duration(duration)</span>}@if (nestedCount > 0)
    {<span class="tool-status">@nestedCount call@(nestedCount == 1 ? "" : "s")</span>}</summary>
  <div class="tool-body">
    @if (call.Args is JsonObject { Count: > 0 })
    {
      <div class="ps-label mb-1">Input</div>
      <div class="ps-term mb-2"><pre class="wrap">@(command ?? ChatDisplay.Pretty(call.Args))</pre></div>
    }
    @if (nestedCount > 0)
    {
      <div class="nested-label">Nested calls</div>
      <div class="nested-calls">
        @foreach (var nested in call.Nested)
        {
          @await Html.PartialAsync("~/Views/Chat/_ChatToolCall.cshtml", new ChatToolView(nested, Model.Context, true))
        }
      </div>
    }
    @if (result is not null)
    {
      <div class="result-head @(nestedCount > 0 ? "mt-2" : "")"><span class="ps-label">@(restarted ? "Output up to the restart" : "Result")</span>
        @if (call.ResultEntryId is { } entry && !Model.Nested)
        {
          <button class="btn btn-icon ms-auto" type="button" title="Fork after this result" aria-label="Fork at entry @entry" data-action="fork" data-entry="@entry"><i class="bi bi-signpost-split"></i></button>
        }
      </div>
      @if (result.Length > 0)
      {
        <div class="ps-term"><pre class="wrap">@result</pre></div>
      }
      @foreach (var image in call.Images)
      {
        <img class="msg-image mt-2" src="@image.DataUrl" alt="Image from @call.Name">
      }
    }
    else if (call.Output is { Length: > 0 } output)
    {
      <div class="ps-label mb-1">Live output</div>
      <div class="ps-term"><pre class="live-output">@output<span class="stream-cursor"></span></pre></div>
    }
    @if (restarted && stored!.Code == "abandoned")
    {
      <div class="fs-8 text-ps-faint mt-2">It never started: a restart ended the call before it. PiSharp doesn't start it again by itself; the model got a note that it did not run.</div>
    }
    else if (restarted)
    {
      <div class="fs-8 text-ps-faint mt-2">Output up to the restart. A command can have side effects, so PiSharp doesn't run it again by itself. The model got this partial output and a note that the command was cut off.</div>
    }
    else if (stopped)
    {
      <div class="fs-8 text-ps-faint mt-2">Stopped before it finished. The model got the output so far and a note that the call was stopped.</div>
    }
  </div>
</details>
@if (approval is not null)
{
  @await Html.PartialAsync("~/Views/Chat/_ChatApproval.cshtml", new ChatApprovalView(approval, true))
}
