@* Decision 0011 (run W2, WU7): a tool call waiting for the user's decision (web-approval), the mockups' inline awaiting-card: Allow once,
   Deny, and in the menu "Always allow <tool> in this chat", "Always allow" (added to Settings › Tools' allow-list) and "Details and deny
   reason…" (#modal-tool-approval). It renders under the call's tool card, or in the "Waiting for you" panel for a call with no card in view.
   The first decision from any tab wins; the prompt comes back after a reload and after a restart that happened while it waited. *@
@model ChatApprovalView
@{
    var request = Model.Approval.Request;
    var command = request.Command;
    var detail = command ?? ChatDisplay.Pretty(request.Arguments);
    var titleId = $"approval-{request.TaskId}-{(Model.Inline ? "inline" : "panel")}";
}
<div class="awaiting-card p-3 my-2" role="group" aria-labelledby="@titleId" data-approval="@request.TaskId" data-tool="@request.Tool" data-agent="@request.AgentId">
  <div class="d-flex align-items-center gap-2 mb-2">
    <i class="bi @ChatDisplay.ToolIcon(request.Tool) text-ps-faint" aria-hidden="true"></i>
    <span class="fw-semibold" id="@titleId">Run <span class="ps-mono">@request.Tool</span>?</span>
    <span class="ms-auto fs-8 text-ps-faint">waiting for you</span>
  </div>
  <div class="ps-term"><pre class="wrap" data-approval-detail>@ChatDisplay.Cut(detail, 4000)</pre></div>
  <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
    <button class="btn btn-sm btn-primary" type="button" data-action="approve" data-decision="allow"><i class="bi bi-check2 me-1"></i>Allow once</button>
    <button class="btn btn-sm btn-outline-danger" type="button" data-action="approve" data-decision="deny">Deny</button>
    <div class="dropdown">
      <button class="btn btn-icon" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="More options" aria-label="More approval options"><i class="bi bi-three-dots"></i></button>
      <ul class="dropdown-menu">
        <li><button class="dropdown-item" type="button" data-action="approve" data-decision="allowChat">Always allow <span class="ps-mono">@request.Tool</span> in this chat</button></li>
        <li><button class="dropdown-item" type="button" data-action="approve" data-decision="allowAlways">Always allow @(command is null ? request.Tool : "this command") (allow-list)</button></li>
        <li><button class="dropdown-item" type="button" data-action="approval-details">Details and deny reason…</button></li>
      </ul>
    </div>
  </div>
  <div class="fs-8 text-ps-faint mt-2">The run is paused until you decide. This prompt comes back after a reload or in another tab, and the first answer wins.</div>
</div>
