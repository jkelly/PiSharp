@* Decision 0011 (run W2, WU7): a chat (GET /chat/{id}), after the mockups' chat page. It renders the stored transcript of the shown branch
   (the chat's current one, or ?agent=N), then chat.js subscribes the tab's stream to chat/{id}/{agent}, whose first view replaces it with
   the live state and whose later views carry each change (committed text about every 150 ms). Closing the tab never stops a run. The top
   bar holds the model switch and the chat's actions (rename, branches, compact, export, delete); the details panel shows the model,
   account (by label), working directory, approval mode and usage. *@
@model ChatPage
@{
    var binding = Model.Binding;
    ViewData["Title"] = binding.Title;
    ViewData[ShellViewData.Nav] = ShellNav.NewChat;
    ViewData[ShellViewData.ActiveChat] = binding.SessionId;
    ViewData[ShellViewData.ContentClass] = "no-scroll";
    ViewData[ShellViewData.Page] = "chat";
    var modelName = Model.Model?.Name ?? binding.Model;
    var providerName = Model.Provider?.DisplayName ?? binding.Provider;
    var picker = new ProviderModelSelect("mp") { Provider = binding.Provider, Model = binding.Model };
    var branches = Model.Agents.Where(agent => agent.Kind != PiSharp.Durable.Hosting.AgentKind.Subagent || agent.Id == Model.Agent.Id).ToList();
    var href = "/chat/" + Uri.EscapeDataString(binding.SessionId);
}
@section Styles {
  <link href="~/css/chat.css" rel="stylesheet" asp-append-version="true">
}
@section TopbarStart {
  <h1 class="app-title"><span class="visually-hidden" data-chat-title>@binding.Title</span></h1>
  <button class="model-switch" type="button" data-bs-toggle="modal" data-bs-target="#modal-model-picker" aria-label="Change model (@modelName)" data-model-switch>
    <span data-model-name>@modelName</span> <span class="sub" data-provider-name>@providerName</span> <i class="bi bi-chevron-down"></i>
  </button>
}
@section TopbarEnd {
  <span class="ps-chip me-1" data-stream-status role="status" hidden><span class="spinner-border spinner-border-sm chip-spinner" aria-hidden="true"></span>Reconnecting…</span>
  @if (branches.Count > 1)
  {
    <div class="dropdown">
      <button class="btn btn-icon" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Branches" aria-label="Branches"><i class="bi bi-diagram-3"></i></button>
      <ul class="dropdown-menu dropdown-menu-end" data-branches>
        <li><h6 class="dropdown-header">Branches</h6></li>
        @foreach (var agent in branches)
        {
          <li><a class="dropdown-item@(agent.Id == Model.Agent.Id ? " active" : "")" aria-current="@(agent.Id == Model.Agent.Id ? "page" : null)" href="@href?agent=@agent.Id">@agent.Name@(agent.Kind == PiSharp.Durable.Hosting.AgentKind.Fork && agent.ForkedAt is { } at ? $" · from #{at}" : "")@(agent.Busy ? " · running" : "")</a></li>
        }
      </ul>
    </div>
  }
  <div class="dropdown">
    <button class="btn btn-icon" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Chat actions" aria-label="Chat actions"><i class="bi bi-three-dots"></i></button>
    <ul class="dropdown-menu dropdown-menu-end">
      <li><button class="dropdown-item" type="button" data-bs-toggle="modal" data-bs-target="#modal-rename-session"><i class="bi bi-pencil me-2"></i>Rename</button></li>
      <li><button class="dropdown-item" type="button" data-bs-toggle="modal" data-bs-target="#modal-compact"><i class="bi bi-arrows-collapse me-2"></i>Compact context</button></li>
      <li><a class="dropdown-item" href="@href/export.md?agent=@Model.Agent.Id" download><i class="bi bi-box-arrow-up me-2"></i>Export as Markdown</a></li>
      <li><hr class="dropdown-divider"></li>
      <li><button class="dropdown-item text-danger" type="button" data-action="archive"><i class="bi bi-trash3 me-2"></i>Delete</button></li>
    </ul>
  </div>
  <button class="btn btn-icon d-none d-xl-inline-block" type="button" data-action="toggle-info" title="Session details" aria-label="Session details"><i class="bi bi-layout-sidebar-reverse"></i></button>
}
<div class="chat-layout info-collapsed" id="chatLayout" data-chat="@binding.SessionId" data-agent="@Model.Agent.Id" data-stream-key="@Model.StreamKey" data-busy="@(Model.Busy ? "true" : "false")">
  <section class="chat-main" aria-label="Conversation">
    <div class="chat-scroll" data-chat-scroll>
      <div class="chat-thread" data-thread aria-live="polite">
        @foreach (var item in Model.Items)
        {
          @await Html.PartialAsync("~/Views/Chat/_ChatItem.cshtml", new ChatItemView(item, Model.Context))
        }
      </div>
    </div>
    <div class="chat-composer-wrap">
      @if (Model.Agent.Id != binding.AgentId || Model.Agent.Kind == PiSharp.Durable.Hosting.AgentKind.Subagent)
      {
        <div class="run-note chat-branch-note"><i class="bi bi-signpost-split" aria-hidden="true"></i>Viewing @Model.Agent.Name. Sending here makes it the chat's current branch.</div>
      }
      <div data-panel="pending"></div>
      <partial name="_ChatComposer" model="new ChatComposerView(false, binding.Thinking, Model.ThinkingLevels, binding.Tier)" />
    </div>
  </section>
  <aside class="pane chat-info" aria-label="Session details">
    <div class="pane-header"><h2 class="pane-title">Session details</h2><button class="btn btn-icon ms-auto" type="button" data-action="toggle-info" title="Hide panel" aria-label="Hide panel"><i class="bi bi-x-lg fs-8"></i></button></div>
    <div class="pane-body">
      <div class="info-section">
        <h6>Model</h6>
        <div class="kv"><span class="k">Provider</span><span class="v" data-info="provider">@binding.Provider</span></div>
        <div class="kv"><span class="k">Model</span><span class="v" data-info="model">@binding.Model</span></div>
        <div class="kv"><span class="k">Thinking</span><span class="v" data-info="thinking">@binding.Thinking</span></div>
        <div class="kv"><span class="k">Speed</span><span class="v" data-info="tier">@(binding.Tier ?? "default")</span></div>
        <div class="kv"><span class="k">Account</span><span class="v" data-info="account">@(Model.Account?.Label ?? "—")</span></div>
      </div>
      <div class="info-section">
        <h6>Usage this branch</h6>
        <div class="kv"><span class="k">Input</span><span class="v" data-info="input">—</span></div>
        <div class="kv"><span class="k">Output</span><span class="v" data-info="output">—</span></div>
        <div class="kv"><span class="k">Cache read</span><span class="v" data-info="cacheRead">—</span></div>
        <div class="kv"><span class="k">Context</span><span class="v" data-info="contextTokens">—</span></div>
      </div>
      <div class="info-section">
        <h6 class="d-flex">Tools <a class="ms-auto text-ps-faint" href="/settings/tools">edit</a></h6>
        <div class="fs-8 text-ps-faint"><i class="bi bi-shield-check me-1"></i>@(Model.ApprovalMode switch
        {
            ToolApprovalMode.Auto => "Tools run without asking",
            ToolApprovalMode.AllowList => "Ask before tools that change things, except the allow-list",
            _ => "Ask before tools that change things",
        })</div>
      </div>
      <div class="info-section border-0">
        <h6>Durable session</h6>
        <div class="kv"><span class="k">Working in</span><span class="v ps-mono text-break">@Model.Cwd</span></div>
        <div class="kv"><span class="k">Session id</span><span class="v ps-mono">@binding.SessionId</span></div>
        <div class="kv"><span class="k">Branch</span><span class="v">@Model.Agent.Name</span></div>
      </div>
    </div>
  </aside>
</div>
@section Modals {
  <partial name="_ChatModelPicker" model="picker" />
  <partial name="_ChatModals" model="binding.Title" />
}
@section Scripts {
  <script type="module" src="~/js/chat.js" asp-append-version="true"></script>
}
