@* Decision 0011 (run W5, E6): the mockups' _DriftSuite: the suite (its page), its baseline and latest run; the paused notice when its schedule
   is paused (Raise cap opens the schedule modal); then a row per target: the model, the worst open signal's level, the signal's message
   and where it stands (the run that saw it first, or waiting for the next run: the next slot, or nothing while the schedule is paused), the
   other open signals folded away, and the row's actions: Compare answers (the run that raised it) and Accept as baseline for drift, Run now
   to confirm for suspect. A target whose worst open signal is info (latency or tokens/s) has no actions, as the mockup's info row has none:
   a speed change never replaces the answer baseline (fix W5 drift 2). A target with no open signal says how it compares with its baseline.
   Model: DriftSuiteView. *@
@model DriftSuiteView
@{
    var suite = Model.Suite;
    var titleId = "drift-" + suite.Id;
}
<section class="ps-card mb-3" aria-labelledby="@titleId" data-drift-suite="@suite.Id">
  <div class="d-flex flex-wrap align-items-center gap-2 px-3 py-2 border-bottom">
    <h3 class="fs-6 fw-semibold mb-0 text-break" id="@titleId"><a class="text-reset text-decoration-none" href="@EvalRoutes.Suite(suite.Id)">@suite.Name</a></h3>
    <span class="fs-8 text-ps-faint">
      @(Model.BaselineText ?? "no baseline yet")
      @if (Model.Latest is { } latest)
      {
        <text> · latest <a class="text-reset" href="@latest.Url">@latest.Title.ToLowerInvariant()</a> (@(latest.Run.Active ? "running" : latest.When))</text>
      }
    </span>
  </div>
  @if (Model.Paused is { } pause)
  {
    <div class="ps-panel d-flex flex-wrap align-items-start gap-2 p-3 m-3 mb-0" role="status" data-schedule-paused="@suite.Id">
      <span class="ps-chip" data-tone="warn">schedule paused</span>
      <div class="flex-grow-1 fs-7 eval-notice-text">@pause.Reason Scheduled runs stay paused until you @(pause.Code == SchedulePause.UnknownPrice ? "enter a price in Settings › Spend and save the schedule again" : "raise the cap or shrink the suite").</div>
      <div class="d-flex flex-wrap gap-2">
        <button class="btn btn-sm btn-outline-secondary" type="button" data-open-schedule="@suite.Id">@(pause.Code == SchedulePause.OverCap ? "Raise cap" : "Schedule")</button>
      </div>
    </div>
  }
  @if (Model.Targets.Count == 0)
  {
    <div class="px-3 py-3 fs-7 text-secondary">This suite has no target.</div>
  }
  else
  {
    <ul class="list-unstyled mb-0">
      @foreach (var row in Model.Targets)
      {
        var worst = row.Signals.FirstOrDefault();
        <li class="drift-row" data-drift-target="@row.Target.Id" data-level="@EvalText.Level(row.Level)">
          <partial name="/Views/Settings/_ProviderLogo.cshtml" model='new LogoModel(row.Model.ProviderName, row.Model.LogoUrl, "sm")' />
          <div class="drift-text">
            <div class="d-flex flex-wrap align-items-center gap-2">
              <span class="ps-mono fs-7"><span class="text-ps-faint text-nowrap">@row.Model.Prefix</span><wbr><span class="text-nowrap">@row.Model.Model</span></span>
              @if (row.Model.Settings != "default settings")
              {
                <span class="fs-8 text-ps-faint">@row.Model.Settings</span>
              }
              <span class="ps-chip" data-tone="@EvalText.Tone(row.Level)" title="@EvalText.LevelTitle(row.Level)">@EvalText.Level(row.Level)</span>
            </div>
            @if (worst is null)
            {
              <div class="fs-7 text-secondary mt-1">@row.Text</div>
            }
            else
            {
              var signal = worst.Signal;
              <div class="fs-7 text-secondary mt-1">@DriftRules.Label(signal.Rule): @signal.Message@(worst.Lineage.Length > 0 && signal.Level == DriftLevel.Drift ? " " + worst.Lineage : "")</div>
              @if (signal.Level == DriftLevel.Suspect)
              {
                <div class="fs-8 text-ps-faint mt-1">
                  @if (Model.Paused is not null)
                  {
                    <text>The schedule is paused, so nothing confirms this until you run the suite.</text>
                  }
                  else if (Model.NextText is { } next)
                  {
                    <text>Waiting for the next run to confirm it: @next.</text>
                  }
                  else
                  {
                    <text>Waiting for the next run to confirm it. The suite has no schedule, so run it to confirm or clear this.</text>
                  }
                </div>
              }
              else if (signal.Level == DriftLevel.Info)
              {
                <div class="fs-8 text-ps-faint mt-1">Information only. Latency and tokens/s changes never become suspect or drift.</div>
              }
              @if (row.Signals.Count > 1)
              {
                <details class="fs-8 mt-1">
                  <summary class="text-ps-faint">Other signals (@((row.Signals.Count - 1).ToString(CultureInfo.InvariantCulture)))</summary>
                  <ul class="list-unstyled text-ps-faint mt-1 mb-0 d-grid gap-1">
                    @foreach (var other in row.Signals.Skip(1))
                    {
                      <li><span class="ps-chip me-1" data-tone="@EvalText.Tone(other.Signal.Level)">@EvalText.Level(other.Signal.Level)</span>@DriftRules.Label(other.Signal.Rule): @other.Signal.Message</li>
                    }
                  </ul>
                </details>
              }
            }
          </div>
          @if (worst is not null && (worst.Signal.Level is DriftLevel.Suspect or DriftLevel.Drift))
          {
            <div class="d-flex flex-wrap gap-2">
              <a class="btn btn-sm btn-outline-secondary" href="@EvalRoutes.Run(worst.Signal.RunId)">Compare answers</a>
              @if (worst.Signal.Level == DriftLevel.Suspect)
              {
                <button class="btn btn-sm btn-outline-secondary" type="button" data-run-suite="@suite.Id" disabled="@(Model.Latest?.Run.Active == true)">Run now to confirm</button>
              }
              else if (worst.Signal.Level == DriftLevel.Drift)
              {
                <button class="btn btn-sm btn-outline-secondary" type="button" data-open-baseline="@suite.Id" data-target-id="@row.Target.Id">Accept as baseline</button>
              }
            </div>
          }
        </li>
      }
    </ul>
  }
</section>
