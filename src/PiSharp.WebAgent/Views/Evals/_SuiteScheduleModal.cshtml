@* Decision 0011 (run W5, E6): the mockups' _SuiteScheduleModal (modal-suite-schedule), shared by the suites, suite and drift pages. With a
   null model it is the empty shell a page renders; evals.js fills it from GET /evals/suites/{id}/schedule (this partial with the suite's
   ScheduleModalView) when a Schedule button is pressed. Repeat: every few hours (with how many runs a day that makes and what they can
   reserve), daily or weekly, in the saved time zone or this computer's. The suite's metered worst case and typical cost per run, with how
   the worst case is worked out (each call: input tokens × input rate + maxTokens × output rate; subscription targets at list price,
   never counted toward caps). The suite-run cap: fits, or refused when the worst case is above it (or a price is unknown, or the suite
   has no case or target), with SuiteService.Refusal's message; Save schedule is disabled while it is refused, and the server refuses it
   again on save. Changing the cap asks the server again (?cap=). Turn off, Cancel, Save schedule. Model: ScheduleModalView (or null). *@
@model ScheduleModalView?
<div class="modal fade" id="modal-suite-schedule" tabindex="-1" aria-labelledby="modal-suite-schedule-title" aria-hidden="true" data-eval-modal="schedule">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    @if (Model is null)
    {
      <div class="modal-content" data-modal-content>
        <div class="modal-header">
          <h2 class="modal-title" id="modal-suite-schedule-title">Schedule suite</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body"><div class="d-flex align-items-center gap-2 fs-7 text-ps-faint"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span>Loading…</div></div>
      </div>
    }
    else
    {
      var suite = Model.Suite;
      var estimate = Model.Estimate;
      var schedule = Model.Schedule;
      var refusal = Model.Refusal;
      var hours = schedule.EveryHours ?? 6;
      var runsPerDay = (24 + hours - 1) / hours;
      var day = schedule.Day ?? ScheduleDay.Monday;
      var metered = estimate.Lines.Where(line => line.Billing is BillingKind.Metered or BillingKind.Free).ToList();
      var listed = estimate.Lines.Where(line => line.Billing == BillingKind.Subscription).ToList();
      var unknown = estimate.Lines.Where(line => line.Billing == BillingKind.Unknown).ToList();
      <div class="modal-content" data-modal-content data-suite-id="@suite.Id" data-suite-name="@suite.Name" data-worst-micros="@estimate.WorstMicros.ToString(CultureInfo.InvariantCulture)"
           data-time-zone="@Model.TimeZone" data-enabled="@(schedule.Enabled ? "true" : "false")" data-refused="@(refusal?.Code)">
        <div class="modal-header">
          <div>
            <h2 class="modal-title" id="modal-suite-schedule-title">Schedule suite</h2>
            <div class="modal-subtitle">@suite.Name · @EvalText.Plural(Model.AnswersPerRun, "answer", "answers") per run</div>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          @if (schedule is { Enabled: true, Paused: { } pause })
          {
            <div class="ps-panel d-flex flex-wrap align-items-start gap-2 p-2 mb-3 fs-7" role="status"><span class="ps-chip" data-tone="warn">paused</span><span class="flex-grow-1 eval-notice-text">@pause.Reason Saving the schedule with a cap that fits resumes it.</span></div>
          }
          <div class="mb-3" data-ss-repeats>
            <span class="form-label d-block" id="ssRepeatLabel">Repeat</span>
            <div class="nav nav-pills mb-2" role="group" aria-labelledby="ssRepeatLabel">
              <button class="nav-link@(Model.RepeatPane == "ss-hours" ? " active" : "")" type="button" data-ss-repeat="hours" aria-pressed="@(Model.RepeatPane == "ss-hours" ? "true" : "false")">Every few hours</button>
              <button class="nav-link@(Model.RepeatPane == "ss-daily" ? " active" : "")" type="button" data-ss-repeat="daily" aria-pressed="@(Model.RepeatPane == "ss-daily" ? "true" : "false")">Daily</button>
              <button class="nav-link@(Model.RepeatPane == "ss-weekly" ? " active" : "")" type="button" data-ss-repeat="weekly" aria-pressed="@(Model.RepeatPane == "ss-weekly" ? "true" : "false")">Weekly</button>
            </div>
            <div data-ss-pane="ss-hours" hidden="@(Model.RepeatPane != "ss-hours")">
              <div class="row g-2">
                <div class="col-6">
                  <label class="form-label fs-7" for="ssHours">Every</label>
                  <div class="input-group input-group-sm"><input class="form-control" id="ssHours" type="number" min="1" max="@SuiteSchedule.MaxEveryHours" step="1" value="@hours.ToString(CultureInfo.InvariantCulture)"><span class="input-group-text">hours</span></div>
                </div>
                <div class="col-6">
                  <label class="form-label fs-7" for="ssHoursStart">Starting at</label>
                  <input class="form-control form-control-sm" id="ssHoursStart" type="time" value="@schedule.At">
                </div>
              </div>
              <div class="form-text" data-ss-day-text>@EvalText.Plural(runsPerDay, "run", "runs") a day can reserve up to @EvalText.Money(estimate.WorstMicros * runsPerDay). A run that doesn't fit is skipped, never partly run.</div>
            </div>
            <div data-ss-pane="ss-daily" hidden="@(Model.RepeatPane != "ss-daily")">
              <label class="form-label fs-7" for="ssDailyTime">At</label>
              <input class="form-control form-control-sm eval-time-input" id="ssDailyTime" type="time" value="@schedule.At">
              <div class="form-text">@Model.ZoneText</div>
            </div>
            <div data-ss-pane="ss-weekly" hidden="@(Model.RepeatPane != "ss-weekly")">
              <div class="row g-2">
                <div class="col-6">
                  <label class="form-label fs-7" for="ssWeekDay">On</label>
                  <select class="form-select form-select-sm" id="ssWeekDay">
                    @foreach (var weekday in Enum.GetValues<ScheduleDay>())
                    {
                      <option value="@EvalJson.Wire(weekday)" selected="@(weekday == day)">@weekday</option>
                    }
                  </select>
                </div>
                <div class="col-6">
                  <label class="form-label fs-7" for="ssWeekTime">At</label>
                  <input class="form-control form-control-sm" id="ssWeekTime" type="time" value="@schedule.At">
                </div>
              </div>
              <div class="form-text">@Model.ZoneText</div>
            </div>
          </div>

          <div class="ps-panel p-3 mb-3" data-ss-estimate>
            <div class="d-flex justify-content-between gap-2 fs-7"><span>Expected worst case per run</span><span class="fw-semibold ps-mono" data-ss-worst>@(estimate.HasUnknownPrice ? "unknown" : EvalText.Money(estimate.WorstMicros))</span></div>
            <div class="d-flex justify-content-between gap-2 fs-7"><span class="text-secondary">Typical, median of the last @SuiteService.TypicalRuns.ToString(CultureInfo.InvariantCulture) runs</span><span class="ps-mono">@(estimate.TypicalMicros is { } typical ? EvalText.Money(typical) : "no runs yet")</span></div>
            <div class="fs-8 text-ps-faint mt-2">Metered spend only.@(estimate.ListMicros > 0 ? " Subscription targets add " + EvalText.ListMoney(estimate.ListMicros) + " at list price, which doesn't count toward money caps." : "")</div>
            @if (estimate.Lines.Count > 0)
            {
              <details class="fs-8 mt-2">
                <summary class="text-ps-faint">How the worst case is worked out</summary>
                <div class="table-responsive mt-2">
                  <table class="table table-sm mb-1 fs-8">
                    <thead><tr><th scope="col">Calls per run</th><th scope="col" class="text-end">Each</th><th scope="col" class="text-end">Run</th></tr></thead>
                    <tbody>
                      @foreach (var line in metered)
                      {
                        <tr><td>@(line.Judge ? "Judge " : "")<span class="ps-mono">@line.Provider/@line.Model</span> × @line.Calls.ToString("N0", CultureInfo.InvariantCulture)@(line.Billing == BillingKind.Free ? ", free" : "")</td><td class="text-end ps-mono">@EvalText.Money(line.EachMicros)</td><td class="text-end ps-mono">@EvalText.Money(line.RunMicros)</td></tr>
                      }
                      <tr><th scope="row">Metered worst case</th><td></td><td class="text-end ps-mono fw-semibold">@EvalText.Money(estimate.WorstMicros)</td></tr>
                      @foreach (var line in listed)
                      {
                        <tr><td class="text-ps-faint">@(line.Judge ? "Judge " : "")<span class="ps-mono">@line.Provider/@line.Model</span> × @line.Calls.ToString("N0", CultureInfo.InvariantCulture), subscription</td><td class="text-end ps-mono text-ps-faint">@EvalText.ListMoney(line.EachMicros)</td><td class="text-end ps-mono text-ps-faint">@EvalText.ListMoney(line.RunMicros) list</td></tr>
                      }
                      @foreach (var line in unknown)
                      {
                        <tr><td class="text-ps-faint">@(line.Judge ? "Judge " : "")<span class="ps-mono">@line.Provider/@line.Model</span> × @line.Calls.ToString("N0", CultureInfo.InvariantCulture)</td><td class="text-end text-ps-faint" colspan="2">no known price</td></tr>
                      }
                    </tbody>
                  </table>
                </div>
                <div class="text-ps-faint">Each call: input tokens × input rate + maxTokens × output rate. A case without maxTokens reserves 8,192 output tokens.</div>
              </details>
            }
          </div>

          <label class="form-label" for="ssCap">Suite-run cap</label>
          <div class="input-group eval-cap-input"><span class="input-group-text">$</span><input class="form-control@(refusal is null ? "" : " is-invalid")" id="ssCap" inputmode="decimal" autocomplete="off" value="@Model.CapText" aria-describedby="ssCapStatus" data-cap-input></div>
          <div id="ssCapStatus" data-ss-cap-status>
            <div data-ss-pane="ss-fits" hidden="@(Model.CapPane != "ss-fits")">
              <div class="form-text">A Spend Guard cap on each run of this suite. Scheduled runs can't ask, so this cap blocks.</div>
              @if (Model.CapMicros is { } cap && refusal is null)
              {
                <div class="d-flex flex-wrap align-items-center gap-2 mt-2 fs-7"><span class="ps-chip" data-tone="ok">fits</span><span>The worst case, @EvalText.Money(estimate.WorstMicros), is within the @EvalText.Money(cap) cap.</span></div>
              }
            </div>
            <div data-ss-pane="ss-refused" hidden="@(Model.CapPane != "ss-refused")">
              <div class="msg-error mt-2" role="alert" data-ss-refused="@(refusal?.Code)">
                <div class="d-flex align-items-start gap-2">
                  <i class="bi bi-x-octagon mt-1" aria-hidden="true"></i>
                  <div>
                    <div class="fw-semibold">Schedule refused</div>
                    <div class="small" data-ss-refused-message>@refusal?.Message</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="fs-8 text-ps-faint mt-3">Missed runs, for example while this computer was asleep, collapse into one. A run is skipped while the previous one is still going, and a scheduled run that would cross another Spend Guard cap is skipped and listed in Spend. The model and account are never switched.</div>
        </div>
        <div class="modal-footer">
          @if (schedule.Enabled)
          {
            <button type="button" class="btn btn-ghost me-auto" data-ss-off>Turn off</button>
          }
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-primary" data-ss-save disabled="@(refusal is not null)">Save schedule</button>
        </div>
      </div>
    }
  </div>
</div>
