@* Decision 0011 (run W5, E6): the mockups' _SuiteHeader: the suite's name and description; Run now (Running… while a run goes), Schedule,
   and the more menu: Set baseline… (_BaselineModal), Rename (an inline form), Export suite (JSON: the Suites unit's export), Delete
   suite… (asks first). Then the key values: size, schedule (with its pause), the suite-run cap, the cost per run (metered worst case and
   typical; list price apart), the baseline and the last run. Model: SuitePage. *@
@model SuitePage
@{
    var suite = Model.Suite;
    var overview = Model.Overview;
    var estimate = overview.Estimate;
    var problem = suite.RunProblem(overview.Cases);
    var schedule = suite.Schedule is { Enabled: true } enabled ? enabled : null;
}
<section class="ps-card p-3 p-md-4 mb-3" aria-label="Suite summary" data-suite-header>
  <div class="d-flex flex-wrap align-items-start gap-3">
    <div class="flex-grow-1 eval-min-0">
      <h2 class="h4 mb-1 text-break" data-suite-name>@suite.Name</h2>
      @if (suite.Description is { } description)
      {
        <p class="fs-7 text-secondary mb-0">@description</p>
      }
      <form class="d-flex flex-wrap gap-2 mt-2" data-rename-form hidden>
        <label class="visually-hidden" for="suiteRename">Suite name</label>
        <input class="form-control form-control-sm eval-rename-input" id="suiteRename" name="name" maxlength="@Suite.MaxName" value="@suite.Name" required>
        <button class="btn btn-sm btn-primary" type="submit">Save</button>
        <button class="btn btn-sm btn-ghost" type="button" data-rename-cancel>Cancel</button>
      </form>
    </div>
    <div class="d-flex flex-wrap gap-2">
      @if (Model.Active is not null)
      {
        <button class="btn btn-sm btn-primary" type="button" disabled><span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>Running…</button>
      }
      else
      {
        <button class="btn btn-sm btn-primary" type="button" data-run-suite="@suite.Id" disabled="@(problem is not null)" title="@problem"><i class="bi bi-play-fill me-1" aria-hidden="true"></i>Run now</button>
      }
      <button class="btn btn-sm btn-outline-secondary" type="button" data-open-schedule="@suite.Id"><i class="bi bi-calendar-event me-1" aria-hidden="true"></i>Schedule</button>
      <div class="dropdown">
        <button class="btn btn-icon" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="More suite actions" title="More"><i class="bi bi-three-dots" aria-hidden="true"></i></button>
        <ul class="dropdown-menu dropdown-menu-end">
          <li><button class="dropdown-item" type="button" data-open-baseline="@suite.Id" disabled="@(Model.LastRun is null)"><i class="bi bi-flag me-2" aria-hidden="true"></i>Set baseline…</button></li>
          <li><button class="dropdown-item" type="button" data-rename-suite><i class="bi bi-pencil me-2" aria-hidden="true"></i>Rename</button></li>
          <li><a class="dropdown-item" href="@(EvalRoutes.ApiSuites + "/" + Uri.EscapeDataString(suite.Id) + "/export")" download><i class="bi bi-filetype-json me-2" aria-hidden="true"></i>Export suite (JSON)</a></li>
          <li><hr class="dropdown-divider"></li>
          <li><button class="dropdown-item" type="button" data-delete-suite="@suite.Id" data-suite-title="@suite.Name"><i class="bi bi-trash3 me-2" aria-hidden="true"></i>Delete suite…</button></li>
        </ul>
      </div>
    </div>
  </div>
  <hr class="my-3">
  <div class="row gx-4 gy-1 fs-7">
    <div class="col-md-6 col-xl-4"><div class="kv"><span class="k">Size</span><span class="v">@EvalText.Size(overview.Cases, suite.Targets.Count, suite.K)</span></div></div>
    <div class="col-md-6 col-xl-4">
      <div class="kv">
        <span class="k">Schedule</span>
        <span class="v">
          @if (schedule is null)
          {
            <text>Off</text>
          }
          else
          {
            <text>@schedule.Label</text>
            @if (schedule.Paused is not null)
            {
              <span class="ps-chip ms-1" data-tone="warn" title="@schedule.Paused.Reason">paused</span>
            }
          }
        </span>
      </div>
    </div>
    <div class="col-md-6 col-xl-4"><div class="kv"><span class="k">Suite-run cap</span><span class="v">@(suite.CapMicros is { } cap ? EvalText.Money(cap) + " · Block" : "None")</span></div></div>
    <div class="col-md-6 col-xl-4">
      <div class="kv">
        <span class="k">Cost per run</span>
        <span class="v" title="Metered spend. Subscription targets show list price, which never counts toward money caps.">
          @if (problem is not null)
          {
            <text>—</text>
          }
          else
          {
            <text>@(estimate.HasUnknownPrice ? "worst unknown" : "worst " + EvalText.Money(estimate.WorstMicros))@(estimate.TypicalMicros is { } typical ? " · typical " + EvalText.Money(typical) : "")</text>
            @if (estimate.ListMicros > 0)
            {
              <span class="text-ps-faint"> · @EvalText.ListMoney(estimate.ListMicros) list</span>
            }
          }
        </span>
      </div>
    </div>
    <div class="col-md-6 col-xl-4">
      <div class="kv">
        <span class="k">Baseline</span>
        <span class="v">
          @if (Model.BaselineUrl is { } baselineUrl)
          {
            <a href="@baselineUrl">@Model.BaselineText</a>
          }
          else
          {
            <text>None yet</text>
          }
        </span>
      </div>
    </div>
    <div class="col-md-6 col-xl-4">
      <div class="kv">
        <span class="k">Last run</span>
        <span class="v">
          @if (Model.LastRun is { } last)
          {
            <a href="@last.Url">@last.Title · @(last.Run.Active ? "running" : last.When)</a>
          }
          else
          {
            <text>None yet</text>
          }
        </span>
      </div>
    </div>
  </div>
</section>
