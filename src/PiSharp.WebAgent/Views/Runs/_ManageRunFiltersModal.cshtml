@* Decision 0011 (run W4, R3): Manage saved filters of History › Runs (#modal-manage-run-filters, after History › Spend's): rename or
   remove each saved filter (a removed one can be undone until Save changes), then POST /api/history/filters/manage with the rest in order.
   history.js runs it. Model: RunHistoryPage. *@
@model RunHistoryPage
<div class="modal fade" id="modal-manage-run-filters" tabindex="-1" aria-labelledby="modal-manage-run-filters-title" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <form class="modal-content" novalidate autocomplete="off" data-run-manage-filters>
      <div class="modal-header">
        <div>
          <h2 class="modal-title" id="modal-manage-run-filters-title">Manage saved filters</h2>
          <div class="modal-subtitle">Rename or remove them. Nothing changes until you save.</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <ul class="list-unstyled d-grid gap-2 mb-0">
          @for (var i = 0; i < Model.Saved.Count; i++)
          {
            var saved = Model.Saved[i];
            <li class="ps-panel px-3 py-2" data-rmf-row data-query="@saved.Query">
              <div class="d-flex align-items-center gap-2">
                <i class="@("bi " + saved.Icon + " text-ps-faint")" aria-hidden="true"></i>
                <label class="visually-hidden" for="@("rmfName" + i)">Name of saved filter @(i + 1)</label>
                <input class="form-control form-control-sm" id="@("rmfName" + i)" maxlength="@RunSavedFilters.MaxNameLength" value="@saved.Name" required data-rmf-name>
                <a class="btn btn-icon" href="@saved.Href" title="Open" aria-label="Open @saved.Name"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a>
                <button class="btn btn-icon" type="button" title="Remove" aria-label="Remove @saved.Name" aria-pressed="false" data-rmf-remove><i class="bi bi-trash3" aria-hidden="true"></i></button>
              </div>
              <div class="fs-8 ps-mono text-ps-faint text-break mt-1">@saved.Description</div>
              <div class="fs-8 text-ps-warn mt-1" data-rmf-removed hidden>Removed when you save. <button class="btn btn-link btn-sm p-0 align-baseline fs-8" type="button" data-rmf-undo>Undo</button></div>
            </li>
          }
        </ul>
        @if (Model.Saved.Count == 0)
        {
          <p class="fs-7 text-ps-faint mb-0">No saved filters. Choose filters, then Save current filters….</p>
        }
        <div class="text-ps-danger fs-7 mt-3" role="alert" data-rmf-error hidden></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save changes</button>
      </div>
    </form>
  </div>
</div>
