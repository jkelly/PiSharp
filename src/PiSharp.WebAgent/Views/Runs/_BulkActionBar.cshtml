@* Decision 0011 (run W4, R3): the mockups' _BulkActionBar, shown while rows are checked (state "selected"): "N selected", Export (the
   chosen runs as CSV or JSON), Delete (a confirm, then POST /api/runs/delete with their ids; a grouped run takes its models and turns
   with it) and Clear selection. history.js fills the count and the export links. Model: RunHistoryPage. *@
@model RunHistoryPage
<div class="bulk-bar ps-panel d-flex flex-wrap align-items-center gap-2 px-3 py-2 mb-2" role="region" aria-label="Bulk actions" data-bulk-bar hidden>
  <i class="bi bi-check2-square text-ps-accent" aria-hidden="true"></i>
  <span class="fw-semibold fs-7"><span class="ps-mono" data-bulk-count>0</span> selected</span>
  <span class="text-ps-faint" aria-hidden="true">·</span>
  <div class="dropdown">
    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-download me-1" aria-hidden="true"></i>Export</button>
    <ul class="dropdown-menu">
      <li><a class="dropdown-item" href="/api/history/export?format=csv" download data-bulk-export="csv"><i class="bi bi-filetype-csv me-2" aria-hidden="true"></i>CSV</a></li>
      <li><a class="dropdown-item" href="/api/history/export?format=json" download data-bulk-export="json"><i class="bi bi-filetype-json me-2" aria-hidden="true"></i>JSON</a></li>
    </ul>
  </div>
  <button class="btn btn-sm btn-outline-danger" type="button" data-bulk-delete><i class="bi bi-trash3 me-1" aria-hidden="true"></i>Delete</button>
  <button class="btn btn-sm btn-ghost ms-auto" type="button" data-bulk-clear>Clear selection</button>
</div>
