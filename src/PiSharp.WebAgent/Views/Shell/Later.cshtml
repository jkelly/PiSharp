@* Decision 0011 (run W2, WU4): the one neutral page behind every sidebar link a later milestone builds (Playground, Compare, Tool Bench,
   History, Evals, Presets). It says what the page will do and offers a new chat; it shows no sample data and no controls that do nothing. *@
@model LaterFeature
@{
    ViewData["Title"] = Model.Title;
    ViewData[ShellViewData.Nav] = Model.Id;
    ViewData[ShellViewData.Page] = "later";
}
<div class="page" data-later="@Model.Id">
  <div class="empty-state later-state">
    <div class="empty-icon"><i class="bi @Model.Icon"></i></div>
    <h3 class="mb-2">Coming in a later milestone</h3>
    <p class="later-summary"><strong>@Model.Title</strong>: @Model.Summary</p>
    <a class="btn btn-primary btn-sm" href="/chat/new"><i class="bi bi-pencil-square me-1"></i>New chat</a>
  </div>
</div>
