@* Decision 0011 (run W2, WU4): the neutral settings page behind every settings link a later milestone builds (Custom providers, Spend,
   Appearance, Data & storage, About), inside _SettingsLayout so the settings nav stays in place. *@
@model LaterFeature
@{
    Layout = "_SettingsLayout";
    ViewData["Title"] = Model.Title;
    ViewData[ShellViewData.SettingsSection] = Model.Id;
    ViewData[ShellViewData.Page] = "settings-later";
}
<div class="settings-header" data-later="@Model.Id">
  <h2>@Model.Title</h2>
  <p>@Model.Summary</p>
</div>
<div class="ps-card empty-state later-state">
  <div class="empty-icon"><i class="bi @Model.Icon"></i></div>
  <h3 class="mb-2">Coming in a later milestone</h3>
  <p class="later-summary mb-0">A later milestone builds this page.</p>
</div>
