@* Decision 0011 (run W2, WU9): the button (or dropdown item) that opens a credential modal for a provider: the API key modal
   (#modal-api-key, _ApiKeyModal: add a key, or replace an account's key) or the provider's sign-in modal (#modal-chatgpt-signin for
   openai-codex, #modal-oauth-signin for the device code sign-ins). It carries only metadata in data attributes (id, name, logo, variant,
   environment variable names, an account's id, label and masked hint); settings.js fills the modal from them. Offline, a sign-in button is
   disabled and says why. Model: CredentialButton. *@
@model CredentialButton
@{
    var provider = Model.Provider;
    var classes = Model.DropdownItem ? "dropdown-item" : Model.Classes;
    var unavailable = Model.SignIn && !provider.SignInAvailable;
    var subtitle = string.Join(" · ", new[] { provider.Id, provider.Apis.Count > 0 ? string.Join(", ", provider.Apis) : null, provider.BaseUrl }
        .Where(part => !string.IsNullOrEmpty(part)));
}
@if (Model.SignIn)
{
  <button type="button" class="@classes" data-bs-toggle="modal" data-bs-target="@SettingsText.SignInModal(provider.Id)" data-signin-provider="@provider.Id"
          data-signin-name="@provider.Name" data-signin-logo="@provider.LogoUrl" data-signin-method="@(Model.Method is { } method ? SettingsText.MethodName(method) : null)"
          data-signin-account="@Model.Account?.Id" data-signin-account-label="@Model.Account?.Label" disabled="@unavailable"
          title="@(unavailable ? ProviderDirectory.OfflineMessage : null)">@if (Model.Icon is not null){<i class="bi @Model.Icon" aria-hidden="true"></i>}@Model.Label</button>
}
else
{
  <button type="button" class="@classes" data-bs-toggle="modal" data-bs-target="#modal-api-key" data-key-provider="@provider.Id" data-key-name="@provider.Name"
          data-key-logo="@provider.LogoUrl" data-key-form="@SettingsText.FormName(provider.KeyForm)" data-key-subtitle="@subtitle"
          data-key-variables="@(string.Join(", ", provider.Variables))" data-key-base-url="@provider.BaseUrl" data-key-account="@Model.Account?.Id"
          data-key-account-label="@Model.Account?.Label" data-key-hint="@Model.Account?.Hint"
          data-key-settings="@(Model.Account is { Settings.Count: > 0 } account ? System.Text.Json.JsonSerializer.Serialize(account.Settings) : null)">@if (Model.Icon is not null){<i class="bi @Model.Icon" aria-hidden="true"></i>}@Model.Label</button>
}
