@* Decision 0011 (run W4, R8): the mockups' _SavePresetModal (#modal-save-preset), shared by the Playground, Compare, Tool Bench and Presets.
   The new pane saves what the page has: name, description, tags (the tags in use are one click away), Pin to the top, the captured settings
   (read-only) and Include (the parts to keep; request headers are off unless ticked); a page that loaded a preset may update it instead.
   On the Presets page, New preset starts from a model (Provider → Model) and a system prompt. The edit pane changes a stored preset's name,
   description, tags and pin, can leave parts out, shows the preset's JSON, and has Delete. A preset never holds a key or a token (the shield
   note); a header or provider option that looks like one is refused. A page hosts the empty shell (Mode host); presets-host.js fills it from
   POST /api/presets/preview when it opens, and presets.js swaps in GET /presets/{id}/edit to edit. Model: SavePresetView. *@
@using PiSharp.WebAgent.Presets
@model SavePresetView
@{
    var draft = Model.Draft;
    var edit = Model.Mode == SavePresetView.EditMode;
    var host = Model.Mode == SavePresetView.HostMode;
    var origin = Model.Origin;
    var named = edit ? draft : origin;
    var ready = !host && Model.Error is null && (draft is not null || Model.Blank);
    var submit = edit ? "Save" : origin is not null ? "Save" : "Save preset";
}
<div class="modal fade" id="modal-save-preset" tabindex="-1" aria-labelledby="modal-save-preset-title" aria-hidden="true" data-preset-save-modal data-page="@Model.Page">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <form class="modal-content" novalidate data-preset-save-form data-mode="@Model.Mode" data-page="@Model.Page" data-preset-id="@(edit ? draft?.Id : null)" data-uses="@(edit ? draft?.Uses : null)" data-origin="@origin?.Id">
      <div class="modal-header">
        <div class="min-w-0">
          <h2 class="modal-title" id="modal-save-preset-title">@Model.Title</h2>
          <div class="modal-subtitle">@Model.Subtitle</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        @if (host)
        {
          <div class="d-flex align-items-center gap-2 fs-7 text-secondary py-4 justify-content-center" role="status">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>Reading the page…
          </div>
        }
        else if (Model.Error is { } error)
        {
          <div class="alert alert-warning d-flex gap-2 fs-7 mb-0" role="alert" data-preset-capture-error>
            <i class="bi bi-exclamation-triangle mt-1" aria-hidden="true"></i>
            <div><div class="fw-semibold mb-1">This page's request can't be saved as a preset yet.</div><div class="text-break">@error</div><div class="mt-1">Fix it on the page, then save again.</div></div>
          </div>
        }
        else
        {
          <div class="row g-3">
            <div class="col-md-7">
              @if (origin is not null && !edit)
              {
                <div class="ps-panel px-3 py-2 mb-3" role="radiogroup" aria-label="Save as">
                  <div class="form-check py-1">
                    <input class="form-check-input" type="radio" name="target" id="sp-target-update" value="update" checked>
                    <label class="form-check-label fs-7" for="sp-target-update">Update “@origin.Name” <span class="d-block fs-8 text-ps-faint">keeps its id, its links and how often it was used</span></label>
                  </div>
                  <div class="form-check py-1">
                    <input class="form-check-input" type="radio" name="target" id="sp-target-new" value="new">
                    <label class="form-check-label fs-7" for="sp-target-new">Save as a new preset</label>
                  </div>
                </div>
              }
              <label class="form-label" for="sp-name">Name</label>
              <input class="form-control" id="sp-name" name="name" maxlength="@Preset.MaxName" required value="@named?.Name" placeholder="e.g. Sonnet SQL explainer · low temp" autocomplete="off">
              <div class="invalid-feedback">Give the preset a name.</div>
              <label class="form-label mt-3" for="sp-desc">Description <span class="text-ps-faint fw-normal">(optional)</span></label>
              <textarea class="form-control" id="sp-desc" name="description" rows="3" maxlength="@Preset.MaxDescription" placeholder="What is this preset for?">@named?.Description</textarea>
              <label class="form-label mt-3" for="sp-tags">Tags</label>
              <input class="form-control" id="sp-tags" name="tags" value="@(named is null ? "" : string.Join(", ", named.Tags))" placeholder="review, cheap" autocomplete="off">
              @if (Model.TagsInUse.Count > 0)
              {
                <div class="d-flex flex-wrap align-items-center gap-1 mt-2">
                  <span class="fs-8 text-ps-faint me-1">Comma-separated. In use:</span>
                  @foreach (var tag in Model.TagsInUse.Take(12))
                  {
                    <button type="button" class="ps-chip" title="Add tag" data-preset-tag="@tag">@tag</button>
                  }
                </div>
              }
              else
              {
                <div class="form-text">Comma-separated.</div>
              }
              <div class="form-check mt-3 mb-0">
                <input class="form-check-input" type="checkbox" id="sp-pin" name="pinned" value="true" checked="@(named?.Pinned == true)">
                <label class="form-check-label fs-7" for="sp-pin">Pin to the top of Presets</label>
              </div>
            </div>
            <div class="col-md-5">
              @if (Model.Blank)
              {
                <div class="ps-label mb-2">Start from</div>
                @if (Model.Picker is { } picker)
                {
                  <partial name="/Views/Shared/_ProviderModelSelect.cshtml" model="picker" />
                }
                <label class="form-label mt-3" for="sp-system">System prompt <span class="text-ps-faint fw-normal">(optional)</span></label>
                <textarea class="form-control font-monospace fs-7" id="sp-system" name="systemPrompt" rows="5" placeholder="You are…"></textarea>
                <div class="form-text">Open the preset in the <a href="/playground">Playground</a> to add parameters, messages and tools, then save it again.</div>
              }
              else
              {
                <div class="ps-label mb-2">Captured settings</div>
                <div class="ps-panel p-3" data-preset-captured>
                  @foreach (var (key, value) in Model.Captured)
                  {
                    <div class="kv"><span class="k">@key</span><span class="v text-break">@value</span></div>
                  }
                </div>
                <div class="form-text">@(edit ? $"Read-only. To change these, open the preset in the {PresetPages.Title(draft!.Kind)} and save it again." : "Read-only. Change these on the page before saving.")</div>
              }
            </div>
          </div>
          @if (!Model.Blank)
          {
            <hr>
            <div class="ps-label mb-2">Include in preset</div>
            <div class="row g-2" data-preset-include>
              @foreach (var part in Model.Parts)
              {
                var id = "sp-inc-" + part.Key;
                <div class="col-sm-6">
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="@id" name="include" value="@part.Key" checked="@part.Checked" disabled="@(!part.Available)">
                    <label class="form-check-label" for="@id">@part.Label</label>
                    <div class="form-text mt-0 text-break">@(part.Available ? part.Detail : edit ? "Not in this preset" : part.Detail)</div>
                  </div>
                </div>
              }
            </div>
          }
          <div class="d-flex gap-2 align-items-start fs-8 text-ps-faint mt-3">
            <i class="bi bi-shield-lock mt-1" aria-hidden="true"></i>
            <span>API keys, OAuth tokens and the <span class="ps-mono">apiKey</span> override are never saved in a preset or in exported JSON; the account is kept by id only. Custom header values are saved as typed, so keep secrets out of them: one that looks like a key is refused.</span>
          </div>
          @if (edit && Model.Json is { } json)
          {
            <details class="mt-3">
              <summary class="fs-7 text-secondary">Preset JSON</summary>
              <div class="ps-term mt-2"><pre class="mb-0"><code class="language-json">@json</code></pre></div>
            </details>
          }
          <div class="alert alert-danger py-2 px-3 fs-7 mt-3 mb-0 text-break" role="alert" data-preset-save-error hidden></div>
        }
      </div>
      <div class="modal-footer">
        @if (edit)
        {
          <button type="button" class="btn btn-outline-danger me-auto" data-preset-delete><i class="bi bi-trash3 me-1" aria-hidden="true"></i>Delete</button>
        }
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary" disabled="@(!ready)" data-preset-save-submit><i class="bi bi-bookmark-check me-1" aria-hidden="true"></i>@submit</button>
      </div>
    </form>
  </div>
</div>
