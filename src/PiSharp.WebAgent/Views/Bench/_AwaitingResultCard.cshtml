@* Decision 0011 (run W4, R7): the mockups' _AwaitingResultCard: a call the bench paused on, waiting for the user's result. It says why the
   bench paused (auto-respond off, a schema violation, no matching mock, a tool the bench did not send) and how long ago, offers the
   tool's saved mocks as quick fills (Edit mocks opens the tool), the format (Text, JSON, Error) and isError, and sends exactly what the
   user wrote as the call's toolResult: "Send result" attaches it, "Send & continue" also runs the next turn once every call has its
   result. bench.js keeps what the user typed when the timeline is swapped. Model: BenchCallView. *@
@model BenchCallView
@{
    var call = Model.Call;
    var tool = Model.Tool;
    var mocks = tool?.Mocks ?? [];
    var pausedAt = (Model.View.Session.PausedAt ?? call.At).ToUnixTimeMilliseconds();
}
<div class="tl-item tl-waiting" data-awaiting="@call.Id">
  <div class="awaiting-card p-3">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
      <span class="status-dot warn"></span>
      <strong class="fs-7">Awaiting result</strong>
      <span class="ps-mono fs-8 text-secondary text-break">@call.Tool · @call.Id</span>
      <span class="ps-chip ms-auto" data-tone="warn" title="Time since the run paused" data-paused-at="@pausedAt">paused <span data-paused-for>0:00</span></span>
    </div>
    <p class="fs-8 text-secondary mb-2">@BenchView.PauseText(call.Pause) Send a result to continue the run. The model sees exactly what you send.</p>

    <div class="ps-label mb-1">Quick fill from saved mocks</div>
    <div class="d-flex flex-wrap gap-1 mb-3">
      @foreach (var mock in mocks)
      {
        <button class="btn btn-sm btn-outline-secondary" type="button" aria-pressed="false" data-fill="@mock.Text" data-fill-error="@(mock.IsError ? "true" : "false")" data-fill-name="@mock.Name">@if (mock.IsError){<i class="bi bi-exclamation-octagon text-ps-danger me-1"></i>}@mock.Name</button>
      }
      @if (mocks.Count == 0)
      {
        <span class="fs-8 text-ps-faint align-self-center me-1">No saved mocks for @call.Tool.</span>
      }
      @if (tool is not null)
      {
        <button class="btn btn-sm btn-ghost" type="button" data-bench-edit="@tool.Name"><i class="bi bi-pencil me-1"></i>Edit mocks</button>
      }
    </div>

    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
      <div class="btn-group btn-group-sm" role="group" aria-label="Result format">
        <input type="radio" class="btn-check" name="@Model.Id("format")" id="@Model.Id("text")" value="text" data-result-format><label class="btn btn-outline-secondary" for="@Model.Id("text")">Text</label>
        <input type="radio" class="btn-check" name="@Model.Id("format")" id="@Model.Id("json")" value="json" checked data-result-format><label class="btn btn-outline-secondary" for="@Model.Id("json")">JSON</label>
        <input type="radio" class="btn-check" name="@Model.Id("format")" id="@Model.Id("err")" value="error" data-result-format><label class="btn btn-outline-secondary" for="@Model.Id("err")">Error</label>
      </div>
      <div class="form-check form-switch mb-0 ms-auto">
        <input class="form-check-input" type="checkbox" role="switch" id="@Model.Id("is-error")" data-result-error>
        <label class="form-check-label fs-7 ps-mono" for="@Model.Id("is-error")">isError</label>
      </div>
    </div>
    <label class="visually-hidden" for="@Model.Id("content")">Result content</label>
    <textarea class="form-control font-monospace" id="@Model.Id("content")" rows="7" spellcheck="false" maxlength="@BenchRunner.MaxResultText" data-result-text></textarea>
    <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
      <span class="fs-8 ps-mono text-ps-faint" data-result-check>empty</span>
      <span class="fs-8 text-ps-faint text-break">Sent as a <span class="ps-mono">toolResult</span> for @call.Id</span>
      <div class="ms-auto d-flex gap-2">
        <button class="btn btn-sm btn-outline-secondary" type="button" title="Attach the result without resuming the run" data-result-send="result">Send result</button>
        <button class="btn btn-sm btn-primary" type="button" data-result-send="continue"><i class="bi bi-play-fill me-1"></i>Send &amp; continue</button>
      </div>
    </div>
  </div>
</div>
