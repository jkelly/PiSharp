<Project Sdk="Microsoft.NET.Sdk">
  <!-- Chord local package admission includes the experimental next runtime (host, jobs, state, store, registries and links)
       and the separately versioned legacy protocol-4 runtime. Runtime and distribution acceptance remain independently recorded. It
       references Contracts, Telemetry and Tools for shared native child containment (Tools brings Agent/AI transitively), and no Durable project: the code joining Chord v2 with
       Durable goes in PiSharp.Durable.Store. Experimental: the assembly is [Experimental("PISHARP_CHORD001")].
       Package admission deliberately retains exact-version friend access to Contracts' schema implementation; these implementation
       types are not part of the public Chord API. See docs/contracts/gap-package-admission.md. Publication requires separate approval. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <!-- Chord's context carries a pi-telemetry span (PiSharp.Telemetry, [Experimental("PISHARP_TELEMETRY001")]), as upstream's does. -->
    <NoWarn>$(NoWarn);PISHARP_TELEMETRY001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Upstream's tests import each layer's internal.ts; the suite reaches the same surface. -->
    <InternalsVisibleTo Include="PiSharp.Chord.Tests" />
    <!-- Native plugin generations wrap an evaluated facet's setup in their own immutable declaration identity. -->
    <InternalsVisibleTo Include="PiSharp.Chord.Hosting" />
    <!-- The StoreStorage cases (area store-storage) attach a hand-built host's batch, as upstream's attach their createHost (phase 6). -->
    <InternalsVisibleTo Include="PiSharp.Durable.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../PiSharp.Contracts/PiSharp.Contracts.csproj" />
    <!-- Upstream's chord depends on @earendil-works/pi-telemetry: its Context carries a telemetry span. -->
    <ProjectReference Include="../PiSharp.Telemetry/PiSharp.Telemetry.csproj" />
    <!-- Legacy native host-manager workers reuse the audited process-tree admission/cleanup implementation. -->
    <ProjectReference Include="../PiSharp.Tools/PiSharp.Tools.csproj" />
  </ItemGroup>
</Project>
