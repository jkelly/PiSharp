{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pisharp.invalid/schemas/experimental-native-extension-0.json",
  "title": "Experimental PiSharp native extension metadata, unfrozen version 0",
  "$comment": "Structural schema only. Runtime also enforces strict retained JSON, budgets, finite/Unicode values, version intervals, artifact coverage and path policy, explicit trust, and real byte integrity. This is never load authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "packageVersion", "hostApiRange", "runtimeKind", "assembly", "entryType", "tfm", "rids", "requiredFeatures", "declaredCapabilities", "resourcePaths", "explicitOverrides", "artifactHashes"],
  "properties": {
    "schemaVersion": { "const": 0 },
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$" },
    "packageVersion": { "$ref": "#/$defs/version" },
    "hostApiRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximumExclusive"],
      "properties": { "minimum": { "$ref": "#/$defs/version" }, "maximumExclusive": { "$ref": "#/$defs/version" } }
    },
    "runtimeKind": { "const": "native" },
    "assembly": { "$ref": "#/$defs/relativePath" },
    "entryType": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:[.+][A-Za-z_][A-Za-z0-9_]*)*$" },
    "tfm": { "const": "net10.0" },
    "rids": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "enum": ["win-x64", "linux-x64", "linux-arm64", "osx-x64", "osx-arm64"] } },
    "requiredFeatures": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/token" } },
    "declaredCapabilities": { "type": "array", "maxItems": 3, "uniqueItems": true, "items": { "enum": ["tools", "commands", "observations"] } },
    "resourcePaths": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/relativePath" } },
    "explicitOverrides": {
      "type": "array", "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["kind", "target"],
        "properties": { "kind": { "enum": ["tool", "command"] }, "target": { "$ref": "#/$defs/token" } }
      }
    },
    "artifactHashes": {
      "type": "object", "minProperties": 1, "maxProperties": 128,
      "propertyNames": { "$ref": "#/$defs/relativePath" },
      "additionalProperties": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" }
    }
  },
  "$defs": {
    "version": { "type": "string", "maxLength": 64, "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$" },
    "token": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$" },
    "relativePath": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\\\:\\u0000-\\u001f\\u007f]+$" }
  }
}
