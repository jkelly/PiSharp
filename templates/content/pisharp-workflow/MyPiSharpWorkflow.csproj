<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Durable and CustomAgents are Tier-2 experimental APIs; opt in explicitly. -->
    <NoWarn>$(NoWarn);PISHARP_DURABLE001;PISHARP_AGENTS001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PiSharp.CustomAgents" Version="1.6.0.1" />
    <PackageReference Include="PiSharp.Durable.Sqlite" Version="1.6.0.1" />
  </ItemGroup>
</Project>
