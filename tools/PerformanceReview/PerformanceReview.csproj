<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <NoWarn>$(NoWarn);CS1998</NoWarn>
  </PropertyGroup>
  <!-- Compile isolated sources so this offline microbenchmark can exercise internal
       streaming state without adding benchmark access to the shipped assemblies. -->
  <ItemGroup>
    <Compile Include="../../src/PiSharp.Contracts/**/*.cs;../../src/PiSharp.AI/**/*.cs;../../src/PiSharp.Sessions/**/*.cs"
             Exclude="../../src/**/obj/**/*.cs;../../src/**/bin/**/*.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="PiComparison.cs" />
  </ItemGroup>
</Project>
