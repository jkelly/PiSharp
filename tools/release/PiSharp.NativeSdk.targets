<Project>
  <!-- Opt-in through CustomAfterMicrosoftCommonTargets; shared projects unchanged. -->
  <PropertyGroup>
    <PiSharpNativeSdkPackage Condition="'$(MSBuildProjectName)' == 'PiSharp.Contracts' Or '$(MSBuildProjectName)' == 'PiSharp.AI' Or '$(MSBuildProjectName)' == 'PiSharp.Agent' Or '$(MSBuildProjectName)' == 'PiSharp.Sessions' Or '$(MSBuildProjectName)' == 'PiSharp.Tools' Or '$(MSBuildProjectName)' == 'PiSharp.Tools.Skia' Or '$(MSBuildProjectName)' == 'PiSharp.CodingAgent' Or '$(MSBuildProjectName)' == 'PiSharp.PromptTemplates.Yaml' Or '$(MSBuildProjectName)' == 'PiSharp.Rpc' Or '$(MSBuildProjectName)' == 'PiSharp.Tui' Or '$(MSBuildProjectName)' == 'PiSharp.Extensions.Abstractions' Or '$(MSBuildProjectName)' == 'PiSharp.Extensions.Runtime' Or '$(MSBuildProjectName)' == 'PiSharp.Extensions.Agent' Or '$(MSBuildProjectName)' == 'PiSharp.ExtensionHost' Or '$(MSBuildProjectName)' == 'PiSharp.Compatibility.Node' Or '$(MSBuildProjectName)' == 'PiSharp.Codemode' Or '$(MSBuildProjectName)' == 'PiSharp.Durable' Or '$(MSBuildProjectName)' == 'PiSharp.Durable.Tools' Or '$(MSBuildProjectName)' == 'PiSharp.Durable.Sqlite' Or '$(MSBuildProjectName)' == 'PiSharp.CustomAgents' Or '$(MSBuildProjectName)' == 'PiSharp.CustomAgents.JavaScript' Or '$(MSBuildProjectName)' == 'PiSharp.CustomAgents.Scripting' Or '$(MSBuildProjectName)' == 'PiSharp.Telemetry' Or '$(MSBuildProjectName)' == 'PiSharp.Chord' Or '$(MSBuildProjectName)' == 'PiSharp.Chord.Hosting' Or '$(MSBuildProjectName)' == 'PiSharp.Durable.Store' Or '$(MSBuildProjectName)' == 'PiSharp.Env.Protocol' Or '$(MSBuildProjectName)' == 'PiSharp.Env'">true</PiSharpNativeSdkPackage>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PiSharpNativeSdkPackage)' == 'true'">
    <IsPackable>true</IsPackable>
    <PackageId>$(MSBuildProjectName)</PackageId>
    <Version>$(PiSharpReleaseVersion)</Version>
    <PackageVersion>$(PiSharpReleaseVersion)</PackageVersion>
    <Authors>PiSharp contributors</Authors>
    <Description>Native .NET library for PiSharp, an independent port of the Pi coding agent. Compatibility is limited to recorded acceptance evidence.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'PiSharp.Contracts'">Shared message, streaming and JSON contracts for PiSharp. Compatibility is limited to recorded acceptance evidence.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'PiSharp.AI'">Streaming LLM provider transports and model catalog for PiSharp. Compatibility is limited to recorded acceptance evidence.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'PiSharp.Agent'">Agent loop, tool invocation and input queues for PiSharp. Compatibility is limited to recorded acceptance evidence.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'PiSharp.Sessions'">Tree-structured session storage, compaction and context for PiSharp. Compatibility is limited to recorded acceptance evidence.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'PiSharp.Tools'">Built-in file and process tools for PiSharp. Compatibility is limited to recorded acceptance evidence.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'PiSharp.Tools.Skia'">SkiaSharp image codec for the PiSharp read tool: decoding, resizing and re-encoding as Pi does. Compatibility is limited to recorded acceptance evidence.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'PiSharp.CodingAgent'">Coding-agent profile with persistent sessions and recovery for PiSharp. Compatibility is limited to recorded acceptance evidence.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'PiSharp.PromptTemplates.Yaml'">YAML frontmatter support for PiSharp prompt templates. Compatibility is limited to recorded acceptance evidence.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'PiSharp.Rpc'">JSON RPC protocol over stdin/stdout for PiSharp. Compatibility is limited to recorded acceptance evidence.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'PiSharp.Tui'">Terminal UI components, input and rendering for PiSharp. Compatibility is limited to recorded acceptance evidence.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'PiSharp.Extensions.Abstractions'">Native .NET extension contracts for PiSharp. Compatibility is limited to recorded acceptance evidence.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'PiSharp.Extensions.Runtime'">Native .NET extension discovery, loading and dispatch for PiSharp. Compatibility is limited to recorded acceptance evidence.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'PiSharp.Extensions.Agent'">Connects PiSharp extension hooks to the agent loop. Compatibility is limited to recorded acceptance evidence.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'PiSharp.ExtensionHost'">Supervised out-of-process extension workers for PiSharp. Compatibility is limited to recorded acceptance evidence.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'PiSharp.Compatibility.Node'">Optional Node.js bridge for Pi TypeScript extensions in PiSharp. Requires Node.js. Compatibility is limited to recorded acceptance evidence.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'PiSharp.Codemode'">Codemode for PiSharp: model-written JavaScript in a Jint sandbox that calls the session's tools. Compatibility is limited to recorded acceptance evidence.</Description>
    <!-- Decision 0005 (released in 1.2.0.1): the durable port is EXPERIMENTAL; its public API is [Experimental("PISHARP_DURABLE001")]. -->
    <Description Condition="'$(MSBuildProjectName)' == 'PiSharp.Durable'">EXPERIMENTAL. Durable agent harness for PiSharp, a port of Pi's pi-durable: sessions, tasks, memory and JSONL storage that commit every step before showing it and resume after a crash. The API may change in any release; opt in by suppressing PISHARP_DURABLE001.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'PiSharp.Durable.Tools'">EXPERIMENTAL. Execution environment, coding tools, tool_search and code mode for PiSharp.Durable. The API may change in any release; opt in by suppressing PISHARP_DURABLE001.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'PiSharp.Durable.Sqlite'">EXPERIMENTAL. SQLite storage for PiSharp.Durable on Microsoft.Data.Sqlite with SQLitePCLRaw's e_sqlite3 native library. The API may change in any release; opt in by suppressing PISHARP_DURABLE001.</Description>
    <!-- Decision 0012 (released in 1.2.0.2): custom agents are EXPERIMENTAL; their public API is [Experimental("PISHARP_AGENTS001")]. -->
    <Description Condition="'$(MSBuildProjectName)' == 'PiSharp.CustomAgents'">EXPERIMENTAL. Custom agents for PiSharp on the durable harness: typed workflows over one shared data class, agent teams with subagents and messaging, typed and dynamic tools, plugin DLLs and web search. The API may change in any release; opt in by suppressing PISHARP_AGENTS001 and PISHARP_DURABLE001.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'PiSharp.CustomAgents.JavaScript'">EXPERIMENTAL. JavaScript tools and workflow actions for PiSharp.CustomAgents, in PiSharp.Codemode's Jint sandbox, with durable code mode for scripts that call tools. The API may change in any release; opt in by suppressing PISHARP_AGENTS001 and PISHARP_DURABLE001.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'PiSharp.CustomAgents.Scripting'">EXPERIMENTAL. C# script tools and workflow actions for PiSharp.CustomAgents, compiled with Roslyn into collectible load contexts. Scripts run with full trust. The API may change in any release; opt in by suppressing PISHARP_AGENTS001 and PISHARP_DURABLE001.</Description>
    <!-- Decision 0013 (Pi 1.5.0 sync, phase 3): the pi-telemetry port is EXPERIMENTAL; its public API is [Experimental("PISHARP_TELEMETRY001")]. -->
    <Description Condition="'$(MSBuildProjectName)' == 'PiSharp.Telemetry'">EXPERIMENTAL. Telemetry contract for PiSharp, a port of Pi's pi-telemetry: spans, links, carriers, metrics and typed schemas, with the no-op and in-memory adapters, a trace store, renderTrace and an adapter conformance kit. Nothing is exported or sent anywhere. The API may change in any release; opt in by suppressing PISHARP_TELEMETRY001.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'PiSharp.Chord'">EXPERIMENTAL. Native Chord host, state, jobs, registries and versioned links. Requires exact-version PiSharp dependencies; internal schema coupling is not a supported public API. Suppress PISHARP_CHORD001.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'PiSharp.Chord.Hosting'">EXPERIMENTAL. Native Chord plugin, HTTP and process-worker hosting. Requires the ASP.NET Core shared framework and trusted application plugins. Suppress PISHARP_CHORD001.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'PiSharp.Durable.Store'">EXPERIMENTAL. Durable storage and registry adapters for Chord with SQLite. Suppress PISHARP_DURABLE001 and PISHARP_CHORD001.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'PiSharp.Env.Protocol'">EXPERIMENTAL. Bounded frame codec for the PiSharp remote environment protocol. Suppress PISHARP_ENV001.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'PiSharp.Env'">EXPERIMENTAL. Remote execution, filesystem, watch and SSH environment client. Daemon artifacts are supplied and verified separately. Suppress PISHARP_ENV001 and PISHARP_DURABLE001.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryCommit>$(PiSharpSourceCommit)</RepositoryCommit>
    <IncludeSymbols>false</IncludeSymbols>
    <IncludeSource>false</IncludeSource>
    <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
  </PropertyGroup>
  <ItemGroup Condition="'$(PiSharpNativeSdkPackage)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)../../README.md" Pack="true" PackagePath="/" />
    <None Include="$(PiSharpProvenanceFile)" Condition="'$(PiSharpProvenanceFile)' != ''" Pack="true" PackagePath="/provenance.json" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'PiSharp.Chord' Or '$(MSBuildProjectName)' == 'PiSharp.Chord.Hosting' Or '$(MSBuildProjectName)' == 'PiSharp.Durable.Store' Or '$(MSBuildProjectName)' == 'PiSharp.Env.Protocol' Or '$(MSBuildProjectName)' == 'PiSharp.Env'">
    <None Include="$(MSBuildThisFileDirectory)../../docs/contracts/gap-package-admission.md" Pack="true" PackagePath="/docs/" />
  </ItemGroup>
  <Target Name="ValidatePiSharpNativeSdkPackageInputs" BeforeTargets="Pack" Condition="'$(PiSharpNativeSdkPackage)' == 'true'">
    <Error Condition="'$(PiSharpReleaseVersion)' == ''" Text="Explicit private SDK version required." />
    <Error Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(PiSharpSourceCommit)', '^[0-9a-f]{40}$')) != 'True'" Text="Exact source commit required." />
    <Error Condition="'$(PiSharpProvenanceFile)' == '' Or !Exists('$(PiSharpProvenanceFile)')" Text="Admitted native SDK provenance required." />
    <Error Condition="'$(TargetFramework)' != 'net10.0'" Text="Only the reviewed net10.0 public native SDK profile is admitted." />
  </Target>
  <!-- Pi 1.5.0 sync, cli.pinned-internal-dependencies (owner decision 2026-11-05): Pi pins its internal packages exactly, so each
       PiSharp package depends on its PiSharp siblings at exactly its own version, [<version>], not at that version or later.
       NuGet reads a project reference's ProjectVersion as a version range; third-party package references are unchanged. -->
  <Target Name="PinPiSharpSiblingVersions" AfterTargets="_GetProjectReferenceVersions" Condition="'$(PiSharpNativeSdkPackage)' == 'true'">
    <ItemGroup>
      <_ProjectReferencesWithVersions>
        <ProjectVersion Condition="$([System.String]::Copy('%(Filename)').StartsWith('PiSharp.')) And !$([System.String]::Copy('%(ProjectVersion)').StartsWith('['))">[%(ProjectVersion)]</ProjectVersion>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
  </Target>
</Project>
