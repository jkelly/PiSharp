---
import Default from '@astrojs/starlight/components/Footer.astro';
import { links } from '../../data/site';
---

<Default />
<div class="ps-footer">
	<p>
		PiSharp is MIT licensed. It is an independent port and not an official Pi release. Pi is created by Mario
		Zechner and maintained by Earendil; derived code keeps its MIT attribution.
	</p>
	<nav aria-label="Footer">
		<a href={links.github}>GitHub</a>
		<a href={links.nuget}>NuGet</a>
		<a href={links.issues}>Issues</a>
		<a href={links.contributing}>Contribute</a>
		<a href="/parity/">Roadmap</a>
		<a href="/changelog/">Changelog</a>
		<a href="/changelog/rss.xml">RSS</a>
		<a href={links.pi}>pi.dev</a>
	</nav>
</div>

<style>
	.ps-footer {
		margin-top: 3rem;
		padding-top: 1.75rem;
		border-top: 1px solid var(--sl-color-gray-5);
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 2.5rem;
		justify-content: space-between;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.ps-footer p {
		max-width: 36rem;
		margin: 0;
	}
	.ps-footer nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.25rem;
	}
	.ps-footer a {
		color: var(--sl-color-gray-3);
		text-decoration: none;
	}
	.ps-footer a:hover {
		color: var(--sl-color-white);
	}
</style>
