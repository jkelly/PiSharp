---
import SitePage from '../components/SitePage.astro';
import { links, versions, inSync } from '../data/site';
import parity from '../data/parity.json';

const statusLabel: Record<string, string> = {
	ported: 'Ported',
	partial: 'Partial',
	planned: 'Planned',
	'wont-port': "Won't port",
	unknown: 'Not yet assessed',
};

const statusMeaning: Record<string, string> = {
	ported: 'Works and is covered by PiSharp tests.',
	partial: 'Works, with the gaps named in the notes.',
	planned: 'Not built yet. On the roadmap.',
	'wont-port': 'Left out of scope on purpose.',
	unknown: 'Status not yet determined.',
};

const assessedOn = new Date(`${parity.assessedOn}T00:00:00Z`).toLocaleDateString('en-GB', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
	timeZone: 'UTC',
});
---

<SitePage title="Parity" description="How close PiSharp is to Pi, across three separate compatibility promises.">
	<div class="ps-pagehead">
		<h1 class="ps-h1">How close to Pi are we?</h1>
		<p class="ps-lede">PiSharp tracks compatibility separately from source updates. The historical assessment below retains its published-release baseline; the current source candidate is shown separately.</p>
		<p class="ps-muted assessed">
			The historical assessment below uses the {parity.baseline} baseline, from PiSharp's own test suites and its <a href={links.compatibility}>compatibility inventories</a>. Assessed on {assessedOn} for release {parity.release}. "Ported" means it works and PiSharp's tests cover it. Some suites compare against output captured from Pi 1.1.0 itself, such as session files; the rest are authored tests. Released 1.5.0.1 coverage is listed separately below, preserving the original assessment and evidence pins.
		</p>
	</div>

	<section class="ps-section candidate">
		<h2 class="ps-h2">Unreleased source candidate: Pi {versions.target}</h2>
		<p class="ps-muted">The source target is <a href={versions.targetUrl}>{versions.targetCommit.slice(0, 8)}</a>. Local source validation is recorded with explicit suite and platform limitations; it does not establish complete parity. The latest published PiSharp release remains {versions.pisharp}, on Pi {versions.baseline}.</p>
		<p class="ps-muted"><a href="https://github.com/jkelly/PiSharp/blob/main/compatibility/sync-1.5.2-applicability.json">Review the complete source applicability map</a> and <a href="https://github.com/jkelly/PiSharp/blob/main/docs/release-notes/1.5.2.md">unreleased candidate notes</a>. Earlier assessment counts, captures and qualification records are preserved below.</p>
	</section>

	<section class="ps-section released">
		<h2 class="ps-h2">Released 1.5.0.1: coverage and qualification</h2>
		<p class="ps-muted">The tables below preserve the 1.5.0 assessment and its historical capture pins. Version 1.5.0.1 adds Chord v2 and legacy runtimes, native hosting, Durable.Store, Env and evaluation tooling, and closes reviewed provider, tool and lifecycle gaps. The four required hosted gates passed for immutable source 8144e3ea; release qualification also includes macOS checks, the three-platform WebAgent suite, validation of all 29 archives and a fresh external consumer of the five new libraries.</p>
		<p class="ps-muted"><a href="/docs/guides/gap-updates/">Read the release updates</a>, the <a href="https://github.com/jkelly/PiSharp/blob/main/compatibility/gap-status-2026-11-08.json">current source/test mapping</a> and the <a href="https://github.com/jkelly/PiSharp/blob/main/AI_DOCS/release-1.5.0.1-publication-results.md">publication evidence</a>. Results retain explicit skips and tested-environment limits. Windows PTY remains unsupported; live providers, real SSH hosts, physical macOS keys, browser/Cloudflare exclusions and native runtime policy differences remain separate.</p>
	</section>

	<div class="strip">
		<div><div class="k">PiSharp</div><div class="v">{versions.pisharp}</div></div>
		<div>
			<div class="k">Baseline</div>
			<div class="v"><a href={versions.baselineUrl}>Pi {versions.baseline}</a></div>
		</div>
		<div><div class="k">Latest Pi</div><div class="v">{versions.latestPi}</div></div>
		<div class="info">
			<strong>{inSync ? 'Published baseline matches the latest Pi' : `Sync to Pi ${versions.latestPi} in progress`}</strong>
			<span>The first three numbers name the Pi baseline. A fourth number (such as 1.5.0.1) is a C#-only patch. <a href="/docs/versioning/">How versions work</a></span>
		</div>
	</div>

	<div role="tablist" aria-label="Compatibility promise" class="tabs">
		{
			parity.promises.map((p, i) => (
				<button role="tab" class="ps-toggle" id={`tab-${p.id}`} aria-controls={`panel-${p.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
					{p.label}
				</button>
			))
		}
	</div>

	<div class="legend">
		<span class="ps-fine">Legend</span>
		{
			Object.entries(statusLabel).map(([tone, label]) => (
				<span class="legend-item">
					<span class="ps-chip" data-tone={tone}>{label}</span>
					<span class="ps-muted">{statusMeaning[tone]}</span>
				</span>
			))
		}
	</div>

	{
		parity.promises.map((p, i) => (
			<div role="tabpanel" id={`panel-${p.id}`} aria-labelledby={`tab-${p.id}`} hidden={i !== 0}>
				<p class="ps-muted blurb">{p.blurb}</p>
				<div class="ps-table-wrap">
					<table>
						<thead>
							<tr><th>Area</th><th>Status</th><th>Notes</th></tr>
						</thead>
						<tbody>
							{p.rows.map((row: { area: string; status: string; notes?: string; evidence?: string }) => (
								<tr>
									<td class="area">{row.area}</td>
									<td><span class="ps-chip" data-tone={row.status}>{statusLabel[row.status] ?? row.status}</span></td>
									<td class="ps-muted">
										{row.notes ?? ''}
										{row.evidence && <> <a href={row.evidence}>Evidence</a></>}
									</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</div>
		))
	}

	<section class="ps-section lower">
		<h2 class="ps-h2">Published 1.5.0 differences</h2>
		<p class="ps-muted">This historical list describes release 1.5.0. Resolutions in 1.5.0.1 are summarized above and in the current mapping; retained entries are not claims that all these gaps remain in the current release.</p>
		<div class="devs">
			{
				parity.deviations.map((group: { title: string; blurb: string; items: { title: string; notes: string }[] }) => (
					<div>
						<h3 class="ps-h3">{group.title}</h3>
						<p class="ps-muted">{group.blurb}</p>
						<ul class="dev-list">
							{group.items.map((item) => (
								<li>
									<strong>{item.title}.</strong> <span class="ps-muted">{item.notes}</span>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</section>

	<section class="ps-section">
		<div class="road-head">
			<h2 class="ps-h2">Roadmap</h2>
			<a href={links.plans}>Full plans on GitHub</a>
		</div>
		<ol class="phases">
			{
				parity.phases.map((ph: { title: string; status: string; notes?: string }, i) => (
					<li>
						<span class="num">Phase {i + 1}</span>
						<div>
							<strong>{ph.title}</strong>
							{ph.notes && <p class="ps-muted">{ph.notes}</p>}
						</div>
						<span class="ps-chip" data-tone={ph.status}>{statusLabel[ph.status] ?? ph.status}</span>
					</li>
				))
			}
		</ol>
	</section>
</SitePage>

<script>
	const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
	const select = (tab: HTMLButtonElement) => {
		for (const t of tabs) {
			const on = t === tab;
			t.setAttribute('aria-selected', String(on));
			t.tabIndex = on ? 0 : -1;
			const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
			if (panel) panel.hidden = !on;
		}
	};
	tabs.forEach((tab, i) => {
		tab.addEventListener('click', () => select(tab));
		tab.addEventListener('keydown', (e) => {
			const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
			if (!step) return;
			const next = tabs[(i + step + tabs.length) % tabs.length];
			select(next);
			next.focus();
		});
	});
</script>

<style>
	.released p {
		max-width: 52rem;
	}
	.strip {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem 3rem;
		background: var(--ps-surface);
		border-radius: 16px;
		padding: 1.5rem 1.75rem;
		margin-bottom: 3.5rem;
	}
	.strip .k {
		font-size: 0.875rem;
		color: var(--sl-color-gray-3);
	}
	.strip .v {
		font-size: 1.5rem;
		font-weight: 600;
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	.strip .v a {
		text-decoration: none;
	}
	.strip .v a:hover {
		text-decoration: underline;
	}
	.strip .info {
		flex: 1 1 18rem;
		display: flex;
		flex-direction: column;
		justify-content: center;
		font-size: 0.9375rem;
		color: var(--sl-color-gray-3);
	}
	.strip .info strong {
		color: var(--sl-color-white);
		font-weight: 600;
	}
	.tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1.25rem;
	}
	.legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 1.4rem;
		align-items: center;
		margin-bottom: 1.5rem;
	}
	.legend-item {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.875rem;
	}
	.assessed {
		max-width: 48rem;
		font-size: 0.9375rem;
	}
	.blurb {
		max-width: 48rem;
		margin-bottom: 1.25rem;
	}
	.area {
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.lower {
		margin-top: 5.5rem;
	}
	.road-head {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		margin-bottom: 1rem;
	}
	.road-head .ps-h2 {
		margin: 0;
	}
	.phases {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.phases li {
		display: grid;
		grid-template-columns: 5rem minmax(0, 1fr) auto;
		gap: 0.25rem 1.25rem;
		align-items: baseline;
		margin: 0;
		padding-block: 0.9rem;
		border-top: 1px solid var(--sl-color-gray-5);
	}
	.phases .num {
		color: var(--sl-color-gray-3);
		font-size: 0.9375rem;
		font-variant-numeric: tabular-nums;
	}
	.phases strong {
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.phases p {
		font-size: 0.9375rem;
		margin: 0.2rem 0 0;
		max-width: 48rem;
		overflow-wrap: anywhere;
	}
	.devs {
		display: grid;
		gap: 2.25rem;
		margin-top: 1.5rem;
	}
	.devs p {
		max-width: 48rem;
	}
	.dev-list {
		margin: 0.6rem 0 0;
		padding-inline-start: 1.2rem;
		display: grid;
		gap: 0.5rem;
		max-width: 52rem;
		overflow-wrap: anywhere;
		font-size: 0.9375rem;
	}
	.dev-list li {
		margin: 0;
	}
	.dev-list strong {
		color: var(--sl-color-white);
		font-weight: 600;
	}
	@media (max-width: 40rem) {
		.phases li {
			grid-template-columns: minmax(0, 1fr) auto;
		}
		.phases .num {
			grid-column: 1 / -1;
		}
	}
</style>
