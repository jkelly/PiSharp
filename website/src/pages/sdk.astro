---
import SitePage from '../components/SitePage.astro';
import { packages } from '../data/packages';

const groups = ['Core', 'Frontends', 'Extensions'] as const;
---

<SitePage title="SDK" description="PiSharp's libraries on NuGet: take the whole agent, or just a layer.">
	<div class="ps-row" style="padding-top: 3rem; margin-bottom: 4rem">
		<div>
			<div class="ps-eyebrow">SDK · NuGet</div>
			<h1 class="ps-h1">Take the whole agent, <em>or just a layer</em></h1>
			<p class="ps-lede">PiSharp is built as separate libraries, each published to NuGet. Use the streaming LLM client on its own, add the agent loop, or embed the full coding agent in your app.</p>
			<div style="display: flex; flex-wrap: wrap; gap: 0.8rem">
				<a href="/docs/embed/sdk/" class="ps-button">Embedding guide →</a>
				<a href="/docs/reference/architecture/" class="ps-button ps-ghost">Architecture</a>
			</div>
		</div>
		<figure class="stack" aria-label="How the libraries build on each other">
			<div class="stack-main">
				<div class="three"><div class="layer">Cli</div><div class="layer">Rpc</div><div class="layer">Tui</div></div>
				<div class="layer" style="border-color: var(--sl-color-accent)">CodingAgent</div>
				<div class="three"><div class="layer">Agent</div><div class="layer">Tools</div><div class="layer">Sessions</div></div>
				<div class="layer" style="border-color: var(--ps-blue)">AI</div>
				<div class="layer base">Contracts</div>
			</div>
			<div class="stack-ext">
				<div class="ps-mono ext-label">EXTENSIONS</div>
				<div class="layer sm">Abstractions</div>
				<div class="layer sm">Runtime</div>
				<div class="layer sm">Agent</div>
				<div class="layer sm">ExtensionHost</div>
				<div class="layer sm" style="border-style: dashed">Compatibility .Node</div>
			</div>
			<figcaption class="ps-muted">Each layer builds on the ones below it. Extensions plug in beside the stack.</figcaption>
		</figure>
	</div>

	{
		groups.map((group) => (
			<section style="margin-bottom: 3rem">
				<h2 class="ps-mono grp">{group}</h2>
				<div class="pkgs">
					{packages
						.filter((p) => p.group === group)
						.map((p) => (
							<div class="ps-card pkg" style={p.optional ? 'border-style: dashed' : undefined}>
								<h3 class="ps-mono"><a href={`https://www.nuget.org/packages/${p.id}`}>{p.id}</a></h3>
								<p class="ps-muted">{p.description}</p>
								<code class="ps-mono add">{p.tool ? `dotnet tool install -g ${p.id}` : `dotnet add package ${p.id}`}</code>
							</div>
						))}
				</div>
			</section>
		))
	}
</SitePage>

<style>
	.stack {
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	.stack-main {
		flex: 3 1 16rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	.stack-ext {
		flex: 1.3 1 9rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		border: 1px dashed var(--sl-color-gray-4);
		border-radius: 10px;
		padding: 0.5rem;
	}
	.stack figcaption {
		flex: 1 1 100%;
		font-size: 0.9rem;
	}
	.three {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.5rem;
	}
	.layer {
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 8px;
		padding: 0.85rem 0.6rem;
		font-family: var(--sl-font-mono);
		font-size: 0.88rem;
		text-align: center;
		background: var(--ps-surface);
		color: var(--sl-color-white);
	}
	.layer.sm {
		font-size: 0.78rem;
		padding: 0.75rem 0.4rem;
	}
	.layer.base {
		background: var(--sl-color-black);
	}
	.ext-label {
		font-size: 0.66rem;
		letter-spacing: 0.14em;
		color: var(--sl-color-gray-3);
		text-align: center;
		padding: 0.25rem 0;
	}
	.grp {
		font-size: 0.75rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--sl-color-gray-3);
		font-weight: 400;
		margin: 0 0 1rem;
		padding-bottom: 0.6rem;
		border-bottom: 1px solid var(--sl-color-gray-5);
	}
	.pkgs {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
		gap: 1.1rem;
	}
	.pkg {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding: 1.35rem;
	}
	.pkg h3 {
		margin: 0;
		font-size: 1rem;
		color: var(--sl-color-white);
	}
	.pkg h3 a {
		color: var(--sl-color-white);
	}
	.pkg p {
		margin: 0;
		flex: 1 1 auto;
		font-size: 0.95rem;
	}
	.add {
		display: block;
		font-size: 0.78rem;
		background: #0a0820;
		color: #c9c4e8;
		border: 1px solid #2e2866;
		border-radius: 6px;
		padding: 0.55rem 0.7rem;
		overflow-x: auto;
		white-space: nowrap;
	}
</style>
