---
import { render } from 'astro:content';
import SitePage from '../../components/SitePage.astro';
import { getReleases } from '../../data/changelog';
import { links } from '../../data/site';

const releases = await Promise.all(
	(await getReleases()).map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
const dateFormat = new Intl.DateTimeFormat('en', { dateStyle: 'medium', timeZone: 'UTC' });
// A label that names a status gets that status's colour; any other label stays grey.
const labelTone = (label: string) => (label.toLowerCase() === 'experimental' ? 'experimental' : undefined);
---

<SitePage title="Changelog" description="PiSharp release notes: Pi syncs and C#-only patches.">
	<div class="log">
		<div class="head">
			<h1 class="ps-h1">Release notes</h1>
			<a href="/changelog/rss.xml" class="ps-button ps-ghost">RSS feed</a>
		</div>
		<p class="ps-lede">
			PiSharp's version is the Pi release it matches. <strong>Pi syncs</strong> move the baseline; <strong>C# patches</strong> add a fourth number and leave it unchanged.
		</p>

		<div role="group" aria-label="Filter releases" class="filters">
			<button class="ps-toggle" data-filter="all" aria-pressed="true">All releases</button>
			<button class="ps-toggle" data-filter="sync" aria-pressed="false">Pi syncs</button>
			<button class="ps-toggle" data-filter="patch" aria-pressed="false">C# patches</button>
		</div>

		<div class="timeline">
			{
				releases.map(({ entry, Content }) => (
					<section class="entry" data-kind={entry.data.kind} id={`v${entry.data.version}`}>
						<span class="dot" data-kind={entry.data.kind} data-status={entry.data.status} aria-hidden="true" />
						<div class="entry-head">
							<h2>{entry.data.version}</h2>
							<span class="ps-chip">{entry.data.kind === 'sync' ? 'Pi sync' : 'C# patch'}</span>
							{entry.data.status === 'in-progress' && <span class="ps-chip" data-tone="partial">In progress</span>}
							{entry.data.labels.map((l) => <span class="ps-chip" data-tone={labelTone(l)}>{l}</span>)}
							{entry.data.date && <span class="date">{dateFormat.format(entry.data.date)}</span>}
						</div>
						<p class="ps-muted baseline">
							{entry.data.kind === 'patch' ? `Baseline unchanged: Pi ${entry.data.baseline}.` : `Matches Pi ${entry.data.baseline}.`}
							{entry.data.status === 'released' && <> <a href={`${links.releases}/tag/v${entry.data.version}`}>GitHub release</a></>}
							{entry.data.kind === 'sync' && <>{entry.data.status === 'released' ? ', ' : ' '}<a href={links.piChangelog}>Pi's release notes</a></>}
						</p>
						<div class="body sl-markdown-content">
							<Content />
						</div>
					</section>
				))
			}
			<p class="ps-muted" id="no-releases" hidden>No releases of this kind yet.</p>
		</div>
	</div>
</SitePage>

<script>
	const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
	const entries = Array.from(document.querySelectorAll<HTMLElement>('.entry'));
	for (const button of buttons) {
		button.addEventListener('click', () => {
			const filter = button.dataset.filter;
			for (const b of buttons) b.setAttribute('aria-pressed', String(b === button));
			for (const e of entries) e.hidden = filter !== 'all' && e.dataset.kind !== filter;
			const empty = document.getElementById('no-releases');
			if (empty) empty.hidden = entries.some((e) => !e.hidden);
		});
	}
</script>

<style>
	.log {
		max-width: 50rem;
		margin: 0 auto;
		padding-top: 3.5rem;
	}
	.head {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1rem;
	}
	.head .ps-h1 {
		margin: 0;
	}
	.log .ps-lede strong {
		color: var(--sl-color-white);
		font-weight: 600;
	}
	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 2.5rem;
	}
	.timeline {
		border-inline-start: 1px solid var(--sl-color-gray-5);
		padding-inline-start: 2rem;
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
		margin-bottom: 4rem;
	}
	.entry {
		position: relative;
	}
	/* A filled dot is a Pi sync, a hollow one a C# patch, a dashed one a release in progress. */
	.dot {
		position: absolute;
		inset-inline-start: calc(-2rem - 6px);
		top: 0.7rem;
		width: 11px;
		height: 11px;
		border-radius: 50%;
		background: var(--sl-color-white);
		box-shadow: 0 0 0 4px var(--sl-color-black);
	}
	.dot[data-kind='patch'] {
		background: var(--sl-color-black);
		border: 2px solid var(--sl-color-gray-3);
	}
	.dot[data-status='in-progress'] {
		background: var(--sl-color-black);
		border: 2px dashed var(--ps-warn);
	}
	.entry-head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6rem;
	}
	.entry-head h2 {
		font-size: 1.5rem;
		font-weight: 600;
		letter-spacing: -0.012em;
		margin: 0;
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.date {
		font-size: 0.875rem;
		color: var(--sl-color-gray-3);
	}
	.baseline {
		margin: 0.5rem 0 0;
		font-size: 0.9375rem;
	}
	.body {
		margin-top: 0.75rem;
	}
	.body :global(h3) {
		font-size: 0.9375rem;
		font-weight: 600;
		color: var(--sl-color-white);
		margin: 1.4rem 0 0.4rem;
	}
</style>
