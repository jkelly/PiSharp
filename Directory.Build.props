<Project>
  <PropertyGroup>
    <!-- Product/release numbering follows the pinned upstream Pi baseline. -->
    <VersionPrefix Condition="'$(VersionPrefix)' == ''">1.1.0.4</VersionPrefix>
    <!-- The approved supervisor import profile uses this stable CLR identity. -->
    <AssemblyVersion Condition="'$(MSBuildProjectName)' == 'PiSharp.ExtensionHost' And '$(AssemblyVersion)' == ''">1.0.0.0</AssemblyVersion>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
</Project>
