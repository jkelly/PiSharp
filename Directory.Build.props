<Project>
  <PropertyGroup>
    <!-- Product/release numbering follows the pinned upstream Pi baseline. -->
    <VersionPrefix Condition="'$(VersionPrefix)' == ''">1.7.0</VersionPrefix>
    <!-- The approved supervisor import profile uses this stable CLR identity. -->
    <AssemblyVersion Condition="'$(MSBuildProjectName)' == 'PiSharp.ExtensionHost' And '$(AssemblyVersion)' == ''">1.0.0.0</AssemblyVersion>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Single source of truth for pinned third-party NuGet package versions across src/ and tests/.
         Projects keep explicit PackageReference Version attributes using these properties so
         packages.lock.json stays byte-stable under RestorePackagesWithLockFile=true. -->
    <PiSharpJintVersion>[4.16.3]</PiSharpJintVersion>
    <PiSharpRoslynVersion>[5.6.0]</PiSharpRoslynVersion>
    <PiSharpSqlClientVersion>[7.1.1]</PiSharpSqlClientVersion>
    <PiSharpSqlClientSniVersion>[7.1.0]</PiSharpSqlClientSniVersion>
    <PiSharpPkcsVersion>[9.0.21]</PiSharpPkcsVersion>
    <PiSharpSqliteVersion>[10.0.12]</PiSharpSqliteVersion>
    <PiSharpSqlitePclRawVersion>[2.1.12]</PiSharpSqlitePclRawVersion>
    <PiSharpYamlDotNetVersion>[16.3.0]</PiSharpYamlDotNetVersion>
    <PiSharpSkiaSharpVersion>[4.152.1]</PiSharpSkiaSharpVersion>
    <PiSharpMarkdigVersion>[0.41.3]</PiSharpMarkdigVersion>
    <PiSharpHtmlSanitizerVersion>[9.1.973]</PiSharpHtmlSanitizerVersion>
    <PiSharpPlaywrightVersion>[1.63.0]</PiSharpPlaywrightVersion>
    <PiSharpExtensionsAIAbstractionsVersion>10.11.1</PiSharpExtensionsAIAbstractionsVersion>
    <PiSharpDependencyInjectionAbstractionsVersion>10.0.0</PiSharpDependencyInjectionAbstractionsVersion>
  </PropertyGroup>
</Project>
