<Project Sdk="Microsoft.NET.Sdk">
  <!-- Decision 0008, Phase 4: the durable device server (src/PiSharp.Durable.Server) and the network client's reducers
       (src/PiSharp.Durable.Client), in Kestrel on a free port with the faux model. Ports of durable-pi's api, streams, recovery and
       shared-state tests (apps/dpi-backend/tests, MIT). The release watcher sample's offline scenario
       (decision 0010, M5) runs here too. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <NoWarn>$(NoWarn);PISHARP_DURABLE001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/PiSharp.Durable.Server/PiSharp.Durable.Server.csproj" />
    <ProjectReference Include="../../samples/Durable.ReleaseWatcher/Durable.ReleaseWatcher.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../PiSharp.Durable.Hosting.Tests/FixtureHttp.cs" Link="FixtureHttp.cs" />
  </ItemGroup>
</Project>
