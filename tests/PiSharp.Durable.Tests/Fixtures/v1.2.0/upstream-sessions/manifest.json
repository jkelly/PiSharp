{
 "description": "Durable sessions written by the pinned upstream pi-durable with pi-ai's faux provider, and a Chord tracker ops corpus. Captured upstream evidence for PiSharp's compat.* cases; regenerate with the command below, never edit by hand.",
 "upstream": {
  "package": "@earendil-works/pi-durable@1.2.0 (sources)",
  "release": "Pi v1.2.0",
  "commit": "06a466935536f8c9bcacb2d5efc0fc021be1bdff",
  "piAi": "@earendil-works/pi-ai 1.2.0 (published build)",
  "chord": "@earendil-works/chord 1.2.0 (sources)",
  "codemode": "@earendil-works/pi-codemode 1.2.0 (sources)"
 },
 "node": "v22.18.0",
 "sqlite": "3.50.2",
 "command": "node --no-warnings --conditions=source --experimental-strip-types tools/DurableFixtures/capture.mjs <pi checkout at the commit> --commit 06a466935536f8c9bcacb2d5efc0fc021be1bdff",
 "clock": {
  "harnessNow": 1767225600000,
  "fauxTimestamp": 1000
 },
 "varies": [
  {
   "field": "sessionId in pi.provider documents",
   "why": "pi-ai uuidv7() on first use: random bits and Date.now(); upstream takes no seed"
  },
  {
   "field": "durationMs of tool result messages",
   "why": "performance.now() around the tool call"
  },
  {
   "field": "SQLite page layout and file bytes",
   "why": "SQLite; the records, not the pages, are the evidence"
  },
  {
   "field": "durationMs anywhere: nested call results (pi.tool.nested documents, observed results, tool events)",
   "why": "performance.now() around each call"
  },
  {
   "field": "the seconds in \"Wall time <seconds> seconds\" of codemode results",
   "why": "the script's wall time, measured by upstream"
  },
  {
   "field": "seed, startedAt and deadline of pi.codemode.run's start, and `at` of pi.codemode.journal entries",
   "why": "code mode's own VM clock (Date.now()) and seed (crypto.getRandomValues), which it journals so a replay sees the same ones"
  }
 ],
 "normalized": "replace every sessionId string with \"<session>\", every durationMs number with \"<duration>\", the seconds of \"Wall time <seconds> seconds\" with \"<seconds>\", and code mode's clock and seed fields as listed, on both sides; nothing else (normalize() in tools/DurableFixtures/compare-captures.mjs)",
 "scenarios": [
  {
   "name": "chat",
   "description": "One input answered: tagged and untagged prompt sections, an offered tool, a request ID.",
   "resumable": false
  },
  {
   "name": "tool-interrupted",
   "description": "A call to an unsafe (not replay-safe) tool, closed while the tool runs after writing output and details: the file holds the execute checkpoint. Resumed: the call settles as interrupted with its durable partial output, then the model answers.",
   "resumable": true
  },
  {
   "name": "follow-up",
   "description": "An input whose generation is in flight and a follow-up queued behind it, closed while the model is still answering. Resumed: the generation reruns and answers, then the queued follow-up runs.",
   "resumable": true
  },
  {
   "name": "compaction",
   "description": "Three turns, a manual compaction placed at once while idle, then one more turn over the compacted context.",
   "resumable": false
  },
  {
   "name": "subagent",
   "description": "A foreground subagent tool (upstream example 22): the call creates a child conversation its task owns, runs one input there, and returns the child's answer to the parent, which answers.",
   "resumable": false
  },
  {
   "name": "fork",
   "description": "Two turns, an ownerless fork at the first answer, and a turn in the fork.",
   "resumable": false
  },
  {
   "name": "task-graph",
   "description": "A conversation-owned task that creates a conversation it owns and a child task it owns; the child creates a grandchild task it owns and waits for it; each waits (allSettled) and completes once its owned work is done.",
   "resumable": false
  },
  {
   "name": "nested-tools",
   "description": "A model-issued tool makes nested calls (harness-nested-tools.test.ts, harness-callers.test.ts): two parallel calls of a tools-only echo (one under an explicit key), a schema tool, a missing tool and invalid arguments; each nested call is its own pi.tool task owned by the caller with a pi.tool.nested document, and the caller returns what it received to the model.",
   "resumable": false,
   "since": "1.2.0",
   "areas": [
    "a"
   ]
  },
  {
   "name": "structured-output",
   "description": "Structured tool output (harness-structured-output.test.ts): model-issued calls of a schema tool (its value stays out of the transcript) and of one whose value breaks its schema (the call stands, the host gets a report); then nested calls of an image tool, an error result without a schema, the broken schema tool, a schema tool's error result keeping its value, and a valid one.",
   "resumable": false,
   "since": "1.2.0",
   "areas": [
    "a"
   ]
  },
  {
   "name": "deferred-tool-search",
   "description": "Deferred tools and tool_search (tool-search.test.ts): two deferred tools stay out of the request until tool_search loads the best match, which pi.agent records in modelTools.add and a pi.system entry appends; the model then calls it.",
   "resumable": false,
   "since": "1.2.0",
   "areas": [
    "a",
    "k"
   ]
  },
  {
   "name": "codemode",
   "description": "Durable code mode (codemode.test.ts): a codemode script calls echo, then the replay-safe hold, then echo, each a nested call journaled before delivery; closed while hold runs. Resumed: the script replays from its journal without running the finished echo again, hold reruns, and the script finishes; the model answers.",
   "resumable": true,
   "since": "1.2.0",
   "areas": [
    "d"
   ]
  },
  {
   "name": "read-image",
   "description": "read returns images (tools-images.test.ts), without an image processor: a 1x1 PNG within the limits comes back as one image block with an info diagnostic; a BMP, which needs converting, is an unsupported_image error result.",
   "resumable": false,
   "since": "1.2.0",
   "areas": [
    "e"
   ]
  },
  {
   "name": "input-entries",
   "description": "Input entries (harness-input-entries.test.ts): an idle input placed as a chat.mention entry carrying its data, with the content as its user message; then an input whose generation is in flight, with a steer (p2.input, no data) and a follow-up (chat.mention) queued in pi.inbox with their entries; closed. Resumed: the generation reruns, then the queued inputs are placed as their entries.",
   "resumable": true,
   "since": "1.2.0",
   "areas": [
    "i"
   ]
  },
  {
   "name": "display-only-write",
   "description": "Display-only writes while busy (harness-input-entries.test.ts, #10407): with a generation in flight and a follow-up queued, a write of only kind and data is appended and settled done at once, while writes with a model message or edits queue; once a reset is queued, a display-only write waits behind it. The answer, the reset, and the follow-up then run in order.",
   "resumable": false,
   "since": "1.2.0",
   "areas": [
    "i"
   ]
  },
  {
   "name": "compaction-failure",
   "description": "Compaction failure (harness-compaction.test.ts): three turns, then a turn whose background threshold compaction fails (pi.live.compactionFailure, compaction_end with error); then a turn over the blocking threshold whose compaction fails too, so the run fails with model_error \"Compaction failed: ...\" without sending its request.",
   "resumable": false,
   "since": "1.2.0",
   "areas": [
    "j"
   ]
  },
  {
   "name": "session-failed",
   "description": "Storage failure closes the Session (harness-storage-failure.test.ts): one input answered, then the storage fails the next commit; the call that hit it rejects with the storage error, later calls with SessionFailed (cause: that error), the event stream ends with session_failed and Harness.closed settles { reason: \"failed\" }. The files hold what was committed before.",
   "resumable": false,
   "since": "1.2.0",
   "areas": [
    "b"
   ]
  },
  {
   "name": "nested-tools-restart",
   "description": "Nested calls across a restart (harness-nested-tools-restart.test.ts): a replay-unsafe caller makes two nested calls, a replay-safe one that publishes output and details and runs, and one a beforeTool hook holds before intent; closed. Resumed: both are abandoned (abandonOnRestart, abortReason \"restart\") before they run again, ending interrupted and abandoned, and the caller settles with an error result; the model answers.",
   "resumable": true,
   "since": "1.2.0",
   "areas": [
    "a",
    "c"
   ]
  },
  {
   "name": "abandon-on-restart",
   "description": "TaskOptions.abandonOnRestart (harness-nested-tools-restart.test.ts): a replay-unsafe tool creates a child task it owns with api.createTask() and awaits it in memory; closed while the child runs. Resumed: the child is marked with abortReason \"restart\" and its abort handler ends it aborted before any phase runs again; the tool call ends interrupted and the model answers.",
   "resumable": true,
   "since": "1.2.0",
   "areas": [
    "c"
   ]
  },
  {
   "name": "wait-cycle",
   "description": "Wait-cycle rejection (harness-structured.test.ts, #10411): conversation-owned task a waits on b; then b commits a wait on a, which closes the cycle a -> b -> a: runtime.commit() rejects it naming the cycle, b ends faulted, and a resumes and completes.",
   "resumable": false,
   "since": "1.2.0",
   "areas": [
    "c"
   ]
  }
 ],
